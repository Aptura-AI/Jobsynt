            }
        }
    </style>
    
    <!-- Enhanced JavaScript with complete functionality -->
    <script>
        // Function to get user's resume data for GPT integration
        async function getUserResumeForGPT() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return null;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume) {
                    return {
                        fileName: resume.file_name,
                        fileType: resume.file_type,
                        fileUrl: resume.file_url,
                        uploadDate: resume.uploaded_at || resume.created_at
                    };
                }
                return null;
            } catch (error) {
                console.error('[Dashboard] Error getting resume for GPT:', error);
                return null;
            }
        }

        // Function to get user's complete profile for GPT integration
        async function getUserProfileForGPT() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return null;

                const { data: profile } = await window.supabase
                    .from('profiles')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                const resumeData = await getUserResumeForGPT();

                return {
                    profile: profile,
                    resume: resumeData,
                    userId: session.user.id,
                    email: session.user.email
                };
            } catch (error) {
                console.error('[Dashboard] Error getting profile for GPT:', error);
                return null;
            }
        }

        // Function to remove favorite company
        async function removeFavoriteCompany(userCompanyId) {
            try {
                if (!confirm('Are you sure you want to remove this company from your favorites?')) {
                    return;
                }

                const { error } = await window.supabase
                    .from('user_companies')
                    .delete()
                    .eq('id', userCompanyId);

                if (error) throw error;

                alert('Company removed from favorites successfully!');
                loadFavoriteCompanies(); // Refresh the list
            } catch (error) {
                console.error('[Dashboard] Error removing favorite company:', error);
                alert('Error removing company. Please try again.');
            }
        }

        // Function to toggle job search tips
        function toggleTips() {
            const tipsContent = document.getElementById('tipsContent');
            const tipsToggle = document.getElementById('tipsToggle');
            
            if (!tipsContent || !tipsToggle) return;
            
            if (tipsContent.style.display === 'none' || tipsContent.style.display === '') {
                tipsContent.style.display = 'block';
                tipsToggle.style.transform = 'rotate(180deg)';
                
                // Save preference to localStorage
                localStorage.setItem('jobSearchTipsExpanded', 'true');
            } else {
                tipsContent.style.display = 'none';
                tipsToggle.style.transform = 'rotate(0deg)';
                
                // Save preference to localStorage
                localStorage.setItem('jobSearchTipsExpanded', 'false');
            }
        }

        // Auto-expand tips based on user preference or first time visit
        function initializeTips() {
            const tipsExpanded = localStorage.getItem('jobSearchTipsExpanded');
            const tipsContent = document.getElementById('tipsContent');
            const tipsToggle = document.getElementById('tipsToggle');
            
            if (tipsContent && tipsToggle) {
                // Show tips by default for first-time users or if previously expanded
                if (tipsExpanded === null || tipsExpanded === 'true') {
                    tipsContent.style.display = 'block';
                    tipsToggle.style.transform = 'rotate(180deg)';
                } else {
                    tipsContent.style.display = 'none';
                    tipsToggle.style.transform = 'rotate(0deg)';
                }
            }
        }

        // Make functions globally available
        window.getUserResumeForGPT = getUserResumeForGPT;
        window.getUserProfileForGPT = getUserProfileForGPT;
        window.removeFavoriteCompany = removeFavoriteCompany;
        window.toggleTips = toggleTips;
        
        // Initialize tips when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeTips);
        } else {
            initializeTips();
        }
        
        // Enhanced employment status handling
        document.addEventListener('DOMContentLoaded', function() {
            const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
            const unemployedSection = document.getElementById('unemployedSection');
            
            if (employmentRadios.length > 0 && unemployedSection) {
                employmentRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.value === 'unemployed') {
                            unemployedSection.style.display = 'block';
                        } else {
                            unemployedSection.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>
</body>
</html>