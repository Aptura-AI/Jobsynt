        </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>&copy; 2024 Jobsynt. All rights reserved.</p>
    </footer>

    <!-- Apprenticeship and Enhanced Job Search JavaScript -->
    <script>
        // Function to display apprenticeship results
        function displayApprenticeshipResults(result) {
            const resultsContainer = document.getElementById('searchResults');
            if (!resultsContainer) return;
            
            resultsContainer.innerHTML = '';
            
            if (!result.success || !result.apprenticeships || result.apprenticeships.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="no-results">
                        <i class="fas fa-search"></i>
                        <h3>No apprenticeships found</h3>
                        <p>Try adjusting your search criteria or location.</p>
                    </div>
                `;
                return;
            }
            
            // Display apprenticeship results
            result.apprenticeships.forEach(apprenticeship => {
                const apprenticeshipCard = document.createElement('div');
                apprenticeshipCard.className = 'job-card apprenticeship-card';
                apprenticeshipCard.innerHTML = `
                    <div class="job-header">
                        <h3>${apprenticeship.title || 'Apprenticeship Opportunity'}</h3>
                        <div class="company-info">
                            <span class="company">${apprenticeship.company || 'Various Employers'}</span>
                            <span class="location">${apprenticeship.location || 'Multiple Locations'}</span>
                        </div>
                    </div>
                    <div class="job-details">
                        <div class="job-meta">
                            <span class="industry"><i class="fas fa-industry"></i> ${apprenticeship.industry || 'Various Industries'}</span>
                            <span class="duration"><i class="fas fa-clock"></i> ${apprenticeship.duration || '1-4 years'}</span>
                            <span class="level"><i class="fas fa-graduation-cap"></i> ${apprenticeship.level || 'Entry Level'}</span>
                        </div>
                        <p class="description">${apprenticeship.description || 'Hands-on training and education opportunity'}</p>
                        ${apprenticeship.requirements ? `<div class="requirements"><strong>Requirements:</strong> ${apprenticeship.requirements}</div>` : ''}
                        ${apprenticeship.benefits ? `<div class="benefits"><strong>Benefits:</strong> ${apprenticeship.benefits}</div>` : ''}
                    </div>
                    <div class="job-actions">
                        <button class="Button Button-primary" onclick="window.open('${apprenticeship.url || '#'}', '_blank')">
                            <i class="fas fa-external-link-alt"></i> Learn More
                        </button>
                        <button class="Button Button-secondary" onclick="saveApprenticeshipForLater('${apprenticeship.id || Date.now()}')">
                            <i class="fas fa-bookmark"></i> Save
                        </button>
                    </div>
                `;
                resultsContainer.appendChild(apprenticeshipCard);
            });
            
            // Add tips for apprenticeships
            const tipsCard = document.createElement('div');
            tipsCard.className = 'tips-card';
            tipsCard.innerHTML = `
                <h4><i class="fas fa-lightbulb"></i> Apprenticeship Tips</h4>
                <ul>
                    <li>Apprenticeships combine work experience with education</li>
                    <li>Many programs offer full-time employment after completion</li>
                    <li>Look for programs that align with your career goals</li>
                    <li>Consider both paid and unpaid opportunities</li>
                    <li>Check if programs offer certifications or degrees</li>
                </ul>
            `;
            resultsContainer.appendChild(tipsCard);
        }
        
        // Function to save apprenticeship for later
        function saveApprenticeshipForLater(apprenticeshipId) {
            // Implementation for saving apprenticeships
            console.log('Saving apprenticeship:', apprenticeshipId);
            alert('Apprenticeship saved for later review!');
        }
        
        // Enhanced job search form handling
        document.addEventListener('DOMContentLoaded', function() {
            const jobSearchForm = document.getElementById('jobSearchForm');
            if (jobSearchForm) {
                jobSearchForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const formData = new FormData(this);
                    const searchType = document.querySelector('input[name="searchType"]:checked')?.value || 'jobs';
                    const jobTitle = formData.get('jobTitle');
                    const location = formData.get('location');
                    const experience = formData.get('experience');
                    
                    // Show loading state
                    const submitButton = this.querySelector('button[type="submit"]');
                    const originalText = submitButton.innerHTML;
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Searching...';
                    submitButton.disabled = true;
                    
                    try {
                        let endpoint, searchData;
                        
                        if (searchType === 'apprenticeships') {
                            endpoint = '/.netlify/functions/apprenticeship-scraper';
                            searchData = {
                                query: jobTitle,
                                location: location,
                                industry: experience // Map experience to industry for apprenticeships
                            };
                        } else {
                            endpoint = '/.netlify/functions/job-scraper';
                            searchData = {
                                position: jobTitle,
                                location: location,
                                experience: experience
                            };
                        }
                        
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify(searchData)
                        });
                        
                        const result = await response.json();
                        
                        if (result.success) {
                            if (searchType === 'apprenticeships') {
                                displayApprenticeshipResults(result);
                            } else {
                                // Handle regular job results (existing functionality)
                                displayJobResults(result);
                            }
                        } else {
                            throw new Error(result.error || 'Search failed');
                        }
                        
                    } catch (error) {
                        console.error('Search error:', error);
                        const resultsContainer = document.getElementById('searchResults');
                        if (resultsContainer) {
                            resultsContainer.innerHTML = `
                                <div class="error-message">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <h3>Search Error</h3>
                                    <p>Unable to complete search. Please try again.</p>
                                </div>
                            `;
                        }
                    } finally {
                        // Restore button state
                        submitButton.innerHTML = originalText;
                        submitButton.disabled = false;
                    }
                });
            }
        });
        
        // Function to display regular job results (fallback)
        function displayJobResults(result) {
            const resultsContainer = document.getElementById('searchResults');
            if (!resultsContainer) return;
            
            resultsContainer.innerHTML = '';
            
            if (!result.success || !result.jobs || result.jobs.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="no-results">
                        <i class="fas fa-search"></i>
                        <h3>No jobs found</h3>
                        <p>Try adjusting your search criteria.</p>
                    </div>
                `;
                return;
            }
            
            // Display job results
            result.jobs.forEach(job => {
                const jobCard = document.createElement('div');
                jobCard.className = 'job-card';
                jobCard.innerHTML = `
                    <div class="job-header">
                        <h3>${job.title || 'Job Opportunity'}</h3>
                        <div class="company-info">
                            <span class="company">${job.company || 'Company'}</span>
                            <span class="location">${job.location || 'Location'}</span>
                        </div>
                    </div>
                    <div class="job-details">
                        <p class="description">${job.description || 'Job description not available'}</p>
                        ${job.salary ? `<div class="salary"><strong>Salary:</strong> ${job.salary}</div>` : ''}
                    </div>
                    <div class="job-actions">
                        <button class="Button Button-primary" onclick="window.open('${job.url || '#'}', '_blank')">
                            <i class="fas fa-external-link-alt"></i> Apply
                        </button>
                        <button class="Button Button-secondary" onclick="saveJobForLater('${job.id || Date.now()}')">
                            <i class="fas fa-bookmark"></i> Save
                        </button>
                    </div>
                `;
                resultsContainer.appendChild(jobCard);
            });
        }
        
        // Function to save job for later
        function saveJobForLater(jobId) {
            console.log('Saving job:', jobId);
            alert('Job saved for later review!');
        }
    </script>

    <!-- Additional CSS for apprenticeship cards -->
    <style>
        .apprenticeship-card {
            border-left: 4px solid #28a745;
        }
        
        .apprenticeship-card .job-header h3::after {
            content: " 🎓";
            font-size: 0.8em;
        }
        
        .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 15px;
            font-size: 0.9em;
            color: #666;
        }
        
        .job-meta span {
