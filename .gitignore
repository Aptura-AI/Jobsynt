# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# Netlify
.netlify/
netlify/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Images and media (exclude all except favicon.ico in public/)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
# Allow only favicon.ico in public root
!public/favicon.ico
# Exclude all other images in public
public/**/*.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.gif
public/**/*.svg
public/**/*.webp

# Documents
*.pdf
*.doc
*.docx

# SQL files
*.sql

# Uploads
/uploads/
public/uploads/

# Old static HTML files (exclude all root HTML files)
*.html
# Allow HTML in app directory if needed
!app/**/*.html

# Old server files
server.js
whatsapp-channel-job-scraper.js
jobsynt-integration.js

# Ghost job finder extension
ghost-job-finder/

# Old API folder (if not using Next.js API routes)
/api/
# But allow app/api
!app/api/

# Old public JS/CSS (keep only what's needed)
public/js/
public/css/
# But allow public structure for Next.js
!public/_headers

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
