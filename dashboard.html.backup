        function analyzeJob(jobUrl, jobDescription) {
            // Navigate to AI Resume Assistant and pre-fill the job analysis form
            showSection('ai-resume');
            
            setTimeout(() => {
                const urlField = document.getElementById('jobUrlAnalysis');
                const descField = document.getElementById('jobDescriptionPreview');
                
                if (urlField && jobUrl) {
                    urlField.value = jobUrl;
                }
                if (descField && jobDescription) {
                    descField.value = decodeURIComponent(jobDescription);
                }
                
                // Scroll to the form
                document.getElementById('jobAnalysisForm')?.scrollIntoView({ behavior: 'smooth' });
            }, 500);
        }

        function initializeEmploymentStatus() {
            // Employment status toggle in AI Job Search
            const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
            const unemployedSection = document.getElementById('unemployedSection');
            
            if (employmentRadios.length > 0 && unemployedSection) {
                employmentRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.value === 'unemployed') {
                            unemployedSection.style.display = 'block';
                        } else {
                            unemployedSection.style.display = 'none';
                        }
                    });
                });
            }
        }

        function initializeAddCompanyModal() {
            const addCompanyBtn = document.getElementById('addCompanyBtn');
            const modal = document.getElementById('addCompanyModal');
            const closeModal = modal?.querySelector('.close-modal');
            const form = document.getElementById('addCompanyForm');

            if (addCompanyBtn && modal) {
                addCompanyBtn.addEventListener('click', function() {
                    modal.style.display = 'flex';
                });

                if (closeModal) {
                    closeModal.addEventListener('click', function() {
                        modal.style.display = 'none';
                    });
                }

                // Close modal when clicking outside
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });

                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        
                        try {
                            const { data: { session } } = await window.supabase.auth.getSession();
                            if (!session) return;

                            const companyData = {
                                name: document.getElementById('companyName').value,
                                website: document.getElementById('companyWebsite').value,
                                linkedin_url: document.getElementById('companyLinkedIn').value,
                                headquarters: document.getElementById('companyLocation').value,
                                description: document.getElementById('companyReason').value,
                                created_at: new Date().toISOString(),
                                updated_at: new Date().toISOString()
                            };

                            // First, insert or get the company
                            const { data: existingCompany, error: checkError } = await window.supabase
                                .from('companies')
                                .select('id')
                                .eq('name', companyData.name)
                                .eq('website', companyData.website)
                                .limit(1);

                            let companyId;

                            if (existingCompany && existingCompany.length > 0) {
                                companyId = existingCompany[0].id;
                            } else {
                                // Insert new company
                                const { data: newCompany, error: insertError } = await window.supabase
                                    .from('companies')
                                    .insert([companyData])
                                    .select('id')
                                    .single();

                                if (insertError) throw insertError;
                                companyId = newCompany.id;
                            }

                            // Create user-company relationship
                            const userCompanyData = {
                                user_id: session.user.id,
                                company_id: companyId,
                                preferred_location: document.getElementById('companyLocation').value,
                                reason: document.getElementById('companyReason').value,
                                created_at: new Date().toISOString(),
                                updated_at: new Date().toISOString()
                            };

                            const { error: relationError } = await window.supabase
                                .from('user_companies')
                                .insert([userCompanyData]);

                            if (relationError) throw relationError;

                            console.log('Company added successfully to favorites');
                            alert('Company added successfully to your favorites!');
                            modal.style.display = 'none';
                            form.reset();
                            
                            // Refresh the companies list
                            loadFavoriteCompanies();
                        } catch (error) {
                            console.error('Error adding company:', error);
                            alert('Error adding company. Please try again.');
                        }
                    });
                }
            }
        }

        function initializeManualApplicationModal() {
            const addManualApplicationBtn = document.getElementById('addManualApplicationBtn');
            const modal = document.getElementById('addManualApplicationModal');
            const closeModal = modal?.querySelector('.close-modal');
            const form = document.getElementById('addManualApplicationForm');

