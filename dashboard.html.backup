        function initializeProfileForm() {
            const profileForm = document.getElementById('profileForm');
            
            if (profileForm) {
                // Add debug button
                const debugBtn = document.createElement('button');
                debugBtn.type = 'button';
                debugBtn.className = 'Button Button-secondary';
                debugBtn.innerHTML = '<i class="fas fa-bug"></i> Debug Form';
                debugBtn.style.marginRight = '10px';
                debugBtn.onclick = debugProfileForm;
                
                const submitBtn = profileForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.parentNode.insertBefore(debugBtn, submitBtn);
                }
                
                profileForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    try {
                        const { data: { session } } = await window.supabase.auth.getSession();
                        if (!session) return;

                        // Collect form data with better error handling
                        const formData = {
                            user_id: session.user.id,
                            email: session.user.email, // Use session email as fallback
                            updated_at: new Date().toISOString()
                        };

                        // Safely collect form values with fallbacks
                        const firstName = document.getElementById('firstName');
                        const lastName = document.getElementById('lastName');
                        const emailField = document.getElementById('email');
                        const phoneField = document.getElementById('phone');
                        const linkedinField = document.getElementById('linkedinUrl');
                        const countryField = document.getElementById('country');
                        const stateField = document.getElementById('state');
                        const cityField = document.getElementById('city');
                        const visaStatusField = document.getElementById('visaStatus');
                        const visaExpiryField = document.getElementById('visaExpiry');
                        const currentTitleField = document.getElementById('currentTitle');
                        const experienceField = document.getElementById('experience');
                        const salaryFromField = document.getElementById('salaryFrom');
                        const salaryToField = document.getElementById('salaryTo');
                        const skillsField = document.getElementById('skills');

                        // Only add fields that exist and have values
                        if (firstName && firstName.value) formData.first_name = firstName.value.trim();
                        if (lastName && lastName.value) formData.last_name = lastName.value.trim();
                        if (emailField && emailField.value) formData.email = emailField.value.trim();
                        if (phoneField && phoneField.value) formData.phone = phoneField.value.trim();
                        if (linkedinField && linkedinField.value) formData.linkedin_url = linkedinField.value.trim();
                        if (countryField && countryField.value) formData.country = countryField.value;
                        if (stateField && stateField.value) formData.state = stateField.value;
                        if (cityField && cityField.value) formData.city = cityField.value.trim();
                        if (visaStatusField && visaStatusField.value) formData.visa_status = visaStatusField.value;
                        if (visaExpiryField && visaExpiryField.value) formData.visa_expiry = visaExpiryField.value;
                        if (currentTitleField && currentTitleField.value) formData.current_title = currentTitleField.value.trim();
                        if (experienceField && experienceField.value) formData.experience_level = experienceField.value;
                        if (salaryFromField && salaryFromField.value) {
                            const salaryFrom = parseInt(salaryFromField.value);
                            if (!isNaN(salaryFrom) && salaryFrom > 0) {
                                formData.salary_range_from = salaryFrom;
                            }
                        }
                        if (salaryToField && salaryToField.value) {
                            const salaryTo = parseInt(salaryToField.value);
                            if (!isNaN(salaryTo) && salaryTo > 0) {
                                formData.salary_range_to = salaryTo;
                            }
                        }
                        if (skillsField && skillsField.value) formData.skills = skillsField.value.trim();

                                                 // Handle employment status
                         const employmentStatus = document.querySelector('input[name="employmentStatus"]:checked');
                         if (employmentStatus) {
                             formData.is_employed = employmentStatus.value === 'employed';
                             if (employmentStatus.value === 'unemployed') {
                                 const unemployedSinceField = document.getElementById('unemployedSinceDate');
                                 if (unemployedSinceField && unemployedSinceField.value) {
                                     formData.unemployed_since = unemployedSinceField.value;
                                 }
                             }
                         }

                        // Collect checkbox data - store as PostgreSQL arrays, not JSON strings
                        const jobTypes = Array.from(document.querySelectorAll('input[name="jobTypes"]:checked')).map(cb => cb.value);
                        const workModes = Array.from(document.querySelectorAll('input[name="workModes"]:checked')).map(cb => cb.value);
                        const contractTypes = Array.from(document.querySelectorAll('input[name="contractTypes"]:checked')).map(cb => cb.value);

                        // Store as arrays directly, not JSON strings
                        if (jobTypes.length > 0) formData.job_types = jobTypes;
                        if (workModes.length > 0) formData.work_modes = workModes;
                        if (contractTypes.length > 0) formData.contract_types = contractTypes;

                        console.log('[Dashboard] Form data to save:', formData);
                        console.log('[Dashboard] Total fields in form data:', Object.keys(formData).length);

                        // Validate required fields
                        if (!formData.user_id) {
                            throw new Error('User ID is missing');
                        }

                        // Check Supabase connection
                        if (!window.supabase) {
                            throw new Error('Database connection not available');
                        }

                        // Update profile in Supabase with better error handling
                        console.log('[Dashboard] About to call Supabase upsert...');
                        console.log('[Dashboard] Supabase client status:', {
                            exists: !!window.supabase,
                            url: window.supabase?.supabaseUrl,
                            hasFrom: typeof window.supabase?.from === 'function'
                        });

                        let data, error;
                        try {
                            const result = await window.supabase
                                .from('profiles')
                                .upsert([formData], { 
                                    onConflict: 'user_id',
                                    returning: 'minimal'
                                });
                            
                            data = result.data;
                            error = result.error;
                            
                            console.log('[Dashboard] Supabase result:', { data, error });
                        } catch (supabaseError) {
                            console.error('[Dashboard] Supabase call failed:', supabaseError);
                            throw new Error(`Supabase call failed: ${supabaseError.message}`);
                        }

                        if (error) {
                            console.error('[Dashboard] Supabase error details:', {
                                message: error.message,
                                details: error.details,
                                hint: error.hint,
                                code: error.code
                            });
                            
                            // Handle specific error types
                            if (error.code === '42P01') {
                                throw new Error('Database table not found. Please check your database setup.');
                            } else if (error.code === '42703') {
                                throw new Error('Database column not found. Please check your database schema.');
                            } else if (error.code === '23505') {
                                throw new Error('Duplicate entry. This should not happen with upsert.');
                            } else if (error.message?.includes('permission denied') || error.message?.includes('RLS')) {
                                throw new Error('Database permission denied. Please check your Row Level Security policies.');
                            } else if (error.message?.includes('malformed array')) {
                                throw new Error('Array data format error. The database schema might need updating.');
                            }
                            
                            throw new Error(`Database error: ${error.message || 'Unknown database error'}`);
                        }

                        alert('Profile saved successfully!');
                        console.log('[Dashboard] Profile saved successfully');
                    } catch (error) {
                        console.error('[Dashboard] Error saving profile:', error);
                        console.error('[Dashboard] Error details:', {
                            message: error.message,
                            stack: error.stack,
                            name: error.name
                        });
                        
                        // Show more specific error message
                        const errorMessage = error.message || 'Unknown error occurred';
                        alert(`Error updating profile: ${errorMessage}\n\nPlease check the console for more details and try again.`);
                    }
                });
            }
        }

