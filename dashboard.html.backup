              <!-- Career Chatbot Sections -->
            <section id="career-chatbot" class="content-section">
                <div class="section-header">
                    <h2>Career Chatbot</h2>
                    <p>Get instant answers to your career questions powered by AI</p>
        </div>
                <div class="chatbot-container" style="height: calc(100vh - 200px); display: flex; flex-direction: column;">
                    <div class="chat-messages" id="chatMessages" style="flex: 1; overflow-y: auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 10px; margin-bottom: 20px;">
                        <div class="welcome-message">
                            <div class="ai-message">
                                <div class="message-content">
                                    <div class="message-avatar">
                                        <i class="fas fa-robot"></i>
                                    </div>
                                    <div class="message-text">
                                        Welcome! I'm your AI career assistant. I have access to your complete profile and can help with job searching, career advice, interview preparation, resume optimization, and more. What would you like to know?
                                    </div>
                                </div>
                            </div>
                        </div>
      </div>
                    <div class="chat-input" style="display: flex; gap: 10px;">
                        <input type="text" id="careerChatInput" class="form-control" placeholder="Ask anything about your career..." style="flex: 1;">
                        <button class="Button Button-primary" id="sendCareerMessage">
            <i class="fas fa-paper-plane"></i>
          </button>
    </div>
    
    <script>
    // Career Chatbot Integration
    document.addEventListener('DOMContentLoaded', function() {
        const careerChatInput = document.getElementById('careerChatInput');
        const sendCareerButton = document.getElementById('sendCareerMessage');
        const chatMessages = document.getElementById('chatMessages');
        
        if (careerChatInput && sendCareerButton && chatMessages) {
            const sendCareerMessage = async () => {
                const message = careerChatInput.value.trim();
                if (!message) return;
                
                // Add user message
                addChatMessage(message, 'user', chatMessages);
                careerChatInput.value = '';
                
                // Show typing indicator
                const typingDiv = document.createElement('div');
                typingDiv.className = 'chat-message ai-message typing-indicator';
                typingDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-avatar">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="message-text">
                            <i class="fas fa-spinner fa-spin"></i> Analyzing your profile and thinking...
                        </div>
                    </div>
                `;
                chatMessages.appendChild(typingDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                try {
                    // Get AI response with career context
                    const aiResponse = await sendMessageToGPT(message, true);
                    
                    // Remove typing indicator
                    typingDiv.remove();
                    
                    // Add AI response
                    addChatMessage(aiResponse, 'ai', chatMessages);
                } catch (error) {
                    // Remove typing indicator
                    typingDiv.remove();
                    
                    // Add error message
                    addChatMessage('Sorry, I encountered an error while analyzing your request. Please try again.', 'ai', chatMessages);
                }
            };
            
            sendCareerButton.addEventListener('click', sendCareerMessage);
            careerChatInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendCareerMessage();
                }
            });
        }
    });
    </script>
  </div>
</section>

            <!-- Floating Chatbot Button -->
