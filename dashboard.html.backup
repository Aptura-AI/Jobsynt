          </button>
    </div>
    
    <script>
    // Career Chatbot Integration
    document.addEventListener('DOMContentLoaded', function() {
        const careerChatInput = document.getElementById('careerChatInput');
        const sendCareerButton = document.getElementById('sendCareerMessage');
        const chatMessages = document.getElementById('chatMessages');
        
        if (careerChatInput && sendCareerButton && chatMessages) {
            const sendCareerMessage = async () => {
                const message = careerChatInput.value.trim();
                if (!message) return;
                
                // Add user message
                addChatMessage(message, 'user', chatMessages);
                careerChatInput.value = '';
                
                // Show typing indicator
                const typingDiv = document.createElement('div');
                typingDiv.className = 'chat-message ai-message typing-indicator';
                typingDiv.innerHTML = `
                    <div class="message-content">
                        <div class="message-avatar">
                            <i class="fas fa-robot"></i>
                        </div>
                        <div class="message-text">
                            <i class="fas fa-spinner fa-spin"></i> Analyzing your profile and thinking...
                        </div>
                    </div>
                `;
                chatMessages.appendChild(typingDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                try {
                    // Get AI response with career context
                    const aiResponse = await sendMessageToGPT(message, true);
                    
                    // Remove typing indicator
                    typingDiv.remove();
                    
                    // Add AI response
                    addChatMessage(aiResponse, 'ai', chatMessages);
                } catch (error) {
                    // Remove typing indicator
                    typingDiv.remove();
                    
                    // Add error message
                    addChatMessage('Sorry, I encountered an error while analyzing your request. Please try again.', 'ai', chatMessages);
                }
            };
            
            sendCareerButton.addEventListener('click', sendCareerMessage);
            careerChatInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendCareerMessage();
                }
            });
        }
    });
    </script>
  </div>
</section>

