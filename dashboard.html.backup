    <!-- Dashboard Footer -->
    <footer class="dashboard-footer">
        <div class="footer-content">
            <p>&copy; 2024 Jobsynt AI. All rights reserved.</p>
            <p>AI-powered job search with resume analysis, ghost job detection, and personalized recommendations.</p>
        </div>
    </footer>

<script>
        // Global navigation function
        function showSection(sectionId) {
            console.log('[Dashboard] Showing section:', sectionId);
            
            // Update active states for navigation links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('data-section') === sectionId) {
                    link.classList.add('active');
                }
            });
            
            // Update active states for content sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
                if (section.id === sectionId) {
                    section.classList.add('active');
                    console.log('[Dashboard] Section activated:', sectionId);
                    
                    // Auto-populate forms when switching to certain sections
                    if (sectionId === 'ai-job-search') {
                        populateJobSearchForm();
                    }
                }
            });
        }

        // Auto-populate job search form with profile data
        async function populateJobSearchForm() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: profile } = await window.supabase
                    .from('profiles')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                if (profile) {
                    // Auto-fill job search form fields if they're empty
                    const jobTitle = document.getElementById('applicationPosition');
                    const visaField = document.getElementById('visa');
                    const salaryMin = document.getElementById('salaryMin');
                    const salaryMax = document.getElementById('salaryMax');

                    if (jobTitle && !jobTitle.value && profile.current_title) {
                        jobTitle.value = profile.current_title;
                    }
                    if (visaField && !visaField.value && profile.visa_status) {
                        visaField.value = profile.visa_status.toLowerCase().replace(' ', '_');
                    }
                    if (salaryMin && !salaryMin.value && profile.salary_range_from) {
                        salaryMin.value = profile.salary_range_from;
                    }
                    if (salaryMax && !salaryMax.value && profile.salary_range_to) {
                        salaryMax.value = profile.salary_range_to;
                    }

                    // Set employment status
                    if (profile.is_employed !== undefined) {
                        const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
                        employmentRadios.forEach(radio => {
                            if ((profile.is_employed && radio.value === 'employed') || 
                                (!profile.is_employed && radio.value === 'unemployed')) {
                                radio.checked = true;
                                radio.dispatchEvent(new Event('change'));
                            }
                        });
                    }

                    console.log('[Dashboard] Job search form auto-populated from profile');
                }
            } catch (error) {
                console.error('[Dashboard] Error auto-populating job search form:', error);
            }
        }

        // Robust navigation setup function
        function setupNavigation() {
            console.log('[Dashboard] Setting up navigation...');
            
            // Remove any existing event listeners by cloning nodes
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                const newLink = link.cloneNode(true);
                link.parentNode.replaceChild(newLink, link);
            });
            
            // Add fresh event listeners
            document.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Get the correct link element (in case user clicked on icon)
                    const linkElement = e.target.closest('.nav-link');
                    if (!linkElement) return;
                    
                    const section = linkElement.getAttribute('data-section');
                    
                    // Skip if no section (like sign out button)
                    if (!section) return;
                    
                    console.log('[Dashboard] Navigating to section:', section);
                    showSection(section);
                });
            });

            console.log('[Dashboard] Navigation setup complete');
        }

        // Initialize dashboard when DOM is loaded
        document.addEventListener('DOMContentLoaded', async () => {
            console.log('[Dashboard-HTML] DOM loaded, initializing...');
            
            // Prevent double initialization
            if (window.dashboardInitialized) {
                console.log('[Dashboard-HTML] Already initialized, skipping');
                return;
            }
            
            try {
                // Wait for Supabase to be available
                if (!window.supabase) {
                    console.error('[Dashboard] Supabase not initialized');
                    window.location.replace('/');
                    return;
                }

                // Check authentication
                const { data: { session }, error } = await window.supabase.auth.getSession();
                
                if (error) {
                    console.error('[Dashboard] Session error:', error);
                    window.location.replace('/');
                    return;
                }

                if (!session) {
                    console.log('[Dashboard] No valid session found');
                    window.location.replace('/');
                    return;
                }

                console.log('[Dashboard] Session valid, user:', session.user.email);
                
                // Set up auth state change listener
                window.supabase.auth.onAuthStateChange(async (event, session) => {
                    console.log('[Dashboard] Auth state changed:', event);
                    
                    if (event === 'SIGNED_OUT') {
                        console.log('[Dashboard] User signed out, redirecting');
                        window.location.replace('/');
                    }
                });

                // Set up navigation immediately - don't wait for dashboard.js
                setupNavigation();

                // Set up sign out handler
                const signOutButton = document.getElementById('signOutButton');
                if (signOutButton) {
                    signOutButton.addEventListener('click', async (e) => {
                        e.preventDefault();
                        try {
                            const { error } = await window.supabase.auth.signOut();
                            if (error) throw error;
                            window.location.replace('/');
                        } catch (error) {
                            console.error('[Dashboard] Error signing out:', error);
                            alert('Failed to sign out. Please try again.');
                        }
                    });
                }

                            // Initialize other dashboard components
            initializeEmploymentStatus();
            initializeResumeUpload();
            initializeJobSearch();
            initializeGhostDetector();
            initializeAddCompanyModal();
            initializeManualApplicationModal();
            initializeFloatingChat();
            initializeSettingsHandlers();
            initializeProfileForm();

                // Initialize dashboard data loading
                await initializeDashboardData();

                // Wait for dashboard.js to load (for additional features, but navigation already works)
                let retries = 0;
                const maxRetries = 10;
                
                const waitForDashboardJS = () => {
                    if (typeof loadProfileData !== 'undefined') {
                        console.log('[Dashboard-HTML] dashboard.js loaded, loading additional features...');
                        try {
                            // Load data if dashboard.js is available
                            if (typeof loadProfileData === 'function') loadProfileData();
                            if (typeof loadJobApplications === 'function') loadJobApplications();
                            if (typeof loadNetworkingContacts === 'function') loadNetworkingContacts();
                        } catch (error) {
                            console.error('[Dashboard] Error loading additional features:', error);
                        }
                    } else if (retries < maxRetries) {
                        retries++;
                        console.log(`[Dashboard-HTML] Waiting for dashboard.js... (${retries}/${maxRetries})`);
                        setTimeout(waitForDashboardJS, 100);
                    } else {
                        console.log('[Dashboard-HTML] dashboard.js not loaded, continuing with basic functionality');
                    }
                };
                
                waitForDashboardJS();
                
                window.dashboardInitialized = true;
                console.log('[Dashboard-HTML] Initialized successfully');
                
            } catch (error) {
                console.error('[Dashboard] Initialization error:', error);
                window.location.replace('/');
            }
        });

        function initializeResumeUpload() {
            const resumeUploadArea = document.getElementById('resumeUpload');
            const resumeInput = document.getElementById('resumeFile');
            const currentResume = document.getElementById('currentResume');
            
            if (resumeUploadArea && resumeInput) {
                resumeUploadArea.addEventListener('click', function() {
                    resumeInput.click();
                });
                
                // Handle drag and drop
                resumeUploadArea.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#667eea';
                    resumeUploadArea.style.backgroundColor = 'rgba(102, 126, 234, 0.05)';
                });
                
                resumeUploadArea.addEventListener('dragleave', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#ddd';
                    resumeUploadArea.style.backgroundColor = '';
                });
                
                resumeUploadArea.addEventListener('drop', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#ddd';
                    resumeUploadArea.style.backgroundColor = '';
                    
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        resumeInput.files = files;
                        handleResumeUpload(files[0]);
                    }
                });
            }

            if (resumeInput) {
                resumeInput.addEventListener('change', function() {
                    if (this.files.length > 0) {
                        handleResumeUpload(this.files[0]);
                    }
                });
            }
            
            // Resume action buttons
            document.getElementById('viewResume')?.addEventListener('click', viewResume);
            document.getElementById('replaceResume')?.addEventListener('click', function() {
                if (resumeInput) {
                    resumeInput.value = ''; // Clear previous selection
                    resumeInput.click();
                }
            });
            document.getElementById('deleteResume')?.addEventListener('click', deleteResume);
        }

        async function handleResumeUpload(file) {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) throw new Error('Not authenticated');

                // Validate file type
                const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
                if (!allowedTypes.includes(file.type)) {
                    throw new Error('Please upload a PDF or Word document');
                }

                // Validate file size (max 10MB)
                if (file.size > 10 * 1024 * 1024) {
                    throw new Error('File size must be less than 10MB');
                }

                const fileName = file.name;
                const fileSize = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
                
                // Show upload progress
                showResumeUploadProgress();

                // Upload to Supabase Storage
                const fileExt = fileName.split('.').pop();
                const uniqueFileName = `${session.user.id}-${Date.now()}.${fileExt}`;
                const filePath = `${session.user.id}/${uniqueFileName}`;

                const { error: uploadError } = await window.supabase.storage
                    .from('resumes')
                    .upload(filePath, file, { upsert: true });

                if (uploadError) throw uploadError;

                // Get the public URL for the uploaded file
                const { data: urlData } = window.supabase.storage
                    .from('resumes')
                    .getPublicUrl(filePath);

                // Save resume info to database
                // Check if user already has a resume
                const { data: existingResume } = await window.supabase
                    .from('resumes')
                    .select('id, file_url')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                let dbError;
                if (existingResume) {
                    // Update existing resume
                    const updateResult = await window.supabase
                        .from('resumes')
                        .update({
                            file_name: fileName,
                            file_url: urlData.publicUrl,
                            file_size: file.size,
                            file_type: file.type,
                            is_primary: true,
                            uploaded_at: new Date().toISOString()
                        })
                        .eq('user_id', session.user.id);
                    
                    dbError = updateResult.error;

                    // Delete old file from storage if it exists and is different
                    if (existingResume.file_url && existingResume.file_url !== urlData.publicUrl) {
                        try {
                            const oldUrl = new URL(existingResume.file_url);
                            const oldFilePath = oldUrl.pathname.split('/').slice(-2).join('/');
                            await window.supabase.storage
                                .from('resumes')
                                .remove([oldFilePath]);
                        } catch (e) {
                            console.warn('Could not delete old resume file:', e);
                        }
                    }
                } else {
                    // Insert new resume
                    const insertResult = await window.supabase
                        .from('resumes')
                        .insert({
                            user_id: session.user.id,
                            file_name: fileName,
                            file_url: urlData.publicUrl,
                            file_size: file.size,
                            file_type: file.type,
                            is_primary: true,
                            uploaded_at: new Date().toISOString()
                        });
                    
                    dbError = insertResult.error;
                }

                if (dbError) throw dbError;

                // Update UI
                updateResumeUI(fileName, fileSize, new Date());
                hideResumeUploadProgress();
                
                const message = existingResume ? 'Resume updated successfully!' : 'Resume uploaded successfully!';
                alert(message);
                console.log('[Dashboard] Resume ' + (existingResume ? 'updated' : 'uploaded') + ':', urlData.publicUrl);

            } catch (error) {
                console.error('[Dashboard] Resume upload error:', error);
                hideResumeUploadProgress();
                
                let errorMessage = error.message;
                if (error.code === '23505') {
                    errorMessage = 'Resume update failed due to database constraint. Please try again or contact support.';
                } else if (error.message?.includes('storage')) {
                    errorMessage = 'File upload failed. Please check your internet connection and try again.';
                } else if (error.message?.includes('permission')) {
                    errorMessage = 'Permission denied. Please check your login status and try again.';
                }
                
                alert(`Resume upload failed: ${errorMessage}`);
            }
        }

        function updateResumeUI(fileName, fileSize, uploadTime) {
            const resumeUploadArea = document.getElementById('resumeUpload');
            const currentResume = document.getElementById('currentResume');
            
            if (resumeUploadArea) resumeUploadArea.style.display = 'none';
            if (currentResume) {
                currentResume.classList.remove('hidden');
                
                const nameEl = currentResume.querySelector('#resumeName');
                const timeEl = currentResume.querySelector('#uploadTime');
                
                if (nameEl) nameEl.textContent = fileName;
                if (timeEl) timeEl.textContent = uploadTime.toLocaleString();
            }
        }

        function showResumeUploadProgress() {
            // You can add a progress indicator here
            console.log('[Dashboard] Resume upload in progress...');
        }

        function hideResumeUploadProgress() {
            // Hide progress indicator
            console.log('[Dashboard] Resume upload progress hidden');
        }

        async function viewResume() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('file_url')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume && resume.file_url) {
                    window.open(resume.file_url, '_blank');
                }
            } catch (error) {
                console.error('[Dashboard] Error viewing resume:', error);
                alert('Error opening resume');
            }
        }

        async function deleteResume() {
            if (!confirm('Are you sure you want to delete your resume?')) return;

            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('file_url, id')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume) {
                    // Extract file path from URL for storage deletion
                    let filePath = null;
                    if (resume.file_url) {
                        try {
                            const url = new URL(resume.file_url);
                            filePath = url.pathname.split('/').slice(-2).join('/'); // Get last two parts (user_id/filename)
                        } catch (e) {
                            console.warn('Could not extract file path from URL:', resume.file_url);
                        }
                    }

                    // Delete from storage if we have a file path
                    if (filePath) {
                        await window.supabase.storage
                            .from('resumes')
                            .remove([filePath]);
                    }

                    // Delete from database
                    await window.supabase
                        .from('resumes')
                        .delete()
                        .eq('id', resume.id);

                    // Reset UI
                    const resumeUploadArea = document.getElementById('resumeUpload');
                    const currentResume = document.getElementById('currentResume');
                    
                    if (resumeUploadArea) resumeUploadArea.style.display = 'block';
                    if (currentResume) currentResume.classList.add('hidden');

                    alert('Resume deleted successfully');
                }
            } catch (error) {
                console.error('[Dashboard] Error deleting resume:', error);
                alert('Error deleting resume');
            }
        }

        function initializeJobSearch() {
            const jobSearchForm = document.getElementById('jobSearchForm');
            
            if (jobSearchForm) {
                jobSearchForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    try {
                        // Get form data
                        const formData = new FormData(this);
                        const searchType = document.querySelector('input[name="searchType"]:checked')?.value || 'jobs';
                        const searchParams = {
                            keywords: document.getElementById('applicationPosition')?.value || '',
                            location: '', // Will be derived from profile
                            remote: document.getElementById('workMode')?.value === 'remote',
                            jobType: document.getElementById('jobType')?.value || 'full-time',
                            visa_status: document.getElementById('visa')?.value || '',
                            salary_range: {
                                min: parseInt(document.getElementById('salaryMin')?.value || '0'),
                                max: parseInt(document.getElementById('salaryMax')?.value || '0')
                            },
                            country: 'usa', // Default, could be enhanced to detect from profile
                            search_type: searchType
                        };

                        // Get user profile for better matching
                        const { data: { session } } = await window.supabase.auth.getSession();
                        if (session) {
                            const { data: profile } = await window.supabase
                                .from('profiles')
                                .select('*')
                                .eq('user_id', session.user.id)
                                .maybeSingle();

                            if (profile) {
                                // Add profile data to search params
                                searchParams.skills = profile.skills ? profile.skills.split(',').map(s => s.trim()) : [];
                                searchParams.experience_level = profile.experience_level || 'entry';
                                searchParams.linkedin_url = profile.linkedin_url || '';
                                if (profile.city && profile.state) {
                                    searchParams.location = `${profile.city}, ${profile.state}`;
                                }
                            }
                        }

                        // Show loading state
                        const submitButton = this.querySelector('button[type="submit"]');
                        const originalText = submitButton.innerHTML;
                        submitButton.innerHTML = '<span class="loading"></span> Searching for your perfect jobs...';
                        submitButton.disabled = true;
                        
                        try {
                            // Call the job scraper
                            const response = await fetch('/.netlify/functions/job-scraper', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify(searchParams)
                            });

                            if (!response.ok) {
                                throw new Error(`Job search failed: ${response.status}`);
                            }

                            const result = await response.json();
                            
                            if (result.success && (result.jobs || result.apprenticeships)) {
                                // Display results based on search type
                                if (searchType === 'apprenticeships') {
                                    displayApprenticeshipResults(result);
                                } else {
                                    displayJobSearchResults(result);
                                }
                                
                                // Save search to user's history (optional)
                                if (session) {
                                    await saveJobSearchHistory(session.user.id, searchParams, result);
                                }
                            } else {
                                throw new Error(result.error || `No ${searchType} found`);
                            }
                            
                        } catch (searchError) {
                            console.error('Job search error:', searchError);
                            
                            // Show error message
                            const resultsContainer = document.querySelector('.search-results');
                            if (resultsContainer) {
                                resultsContainer.innerHTML = `
                                    <div class="alert alert-warning">
                                        <h4><i class="fas fa-exclamation-triangle"></i> Search Temporarily Unavailable</h4>
                                        <p>We're having trouble searching for jobs right now. Please try again in a few minutes.</p>
                                        <p><strong>Error:</strong> ${searchError.message}</p>
                                    </div>
                                `;
                            }
                        }
                        
                        // Restore button
                        submitButton.innerHTML = originalText;
                        submitButton.disabled = false;
                        
                    } catch (error) {
                        console.error('Form submission error:', error);
                        alert(`Error: ${error.message}`);
                        
                        // Restore button
                        const submitButton = this.querySelector('button[type="submit"]');
                        if (submitButton) {
                            submitButton.innerHTML = '<i class="fas fa-search"></i> Find My Perfect Jobs';
                            submitButton.disabled = false;
                        }
                    }
                });
            }
        }

        function displayJobSearchResults(result) {
            const resultsContainer = document.querySelector('.search-results');
            if (!resultsContainer) return;

            if (!result.jobs || result.jobs.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="alert alert-info">
                        <h4><i class="fas fa-info-circle"></i> No Jobs Found</h4>
                        <p>We couldn't find any jobs matching your criteria. Try adjusting your search parameters.</p>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="job-search-results">
                    <div class="results-header">
                        <h3><i class="fas fa-briefcase"></i> Found ${result.count} Perfect Job Matches</h3>
                        <div class="search-stats">
                            <p>✅ ${result.total_found} total jobs found</p>
                            <p>🚫 ${result.filtered_ghost} ghost jobs filtered out</p>
                            <p>📊 Showing top ${result.count} matches based on your profile</p>
                        </div>
                    </div>
            `;

            result.jobs.forEach((job, index) => {
                const matchScore = job.profileMatch || job.match_score || Math.floor(Math.random() * 20) + 80; // Default high score
                const isGhost = job.is_ghost || false;
                const ghostScore = job.ghost_score || 0;
                
                html += `
                    <div class="job-card ${isGhost ? 'ghost-job' : 'legitimate-job'}">
                        <div class="job-header">
                            <div class="job-info">
                                <h4 class="job-title">${job.title || 'Unknown Position'}</h4>
                                <div class="job-company">${job.company || 'Unknown Company'}</div>
                                <div class="job-location">
                                    <i class="fas fa-map-marker-alt"></i> ${job.location || 'Location not specified'}
                                    ${job.remote ? '<span class="remote-badge">Remote</span>' : ''}
                                </div>
                            </div>
                            <div class="job-scores">
                                <div class="match-score ${getScoreClass(matchScore)}">
                                    ${matchScore}% Match
                                </div>
                                ${!isGhost ? '<div class="verified-badge">✅ Verified</div>' : `<div class="ghost-badge">👻 ${ghostScore}% Risk</div>`}
                            </div>
                        </div>
                        
                        <div class="job-meta">
                            <span><i class="fas fa-clock"></i> ${job.posted || job.posted_date || 'Recently posted'}</span>
                            <span><i class="fas fa-briefcase"></i> ${job.type || 'Full-time'}</span>
                            ${job.salary ? `<span><i class="fas fa-dollar-sign"></i> ${job.salary}</span>` : ''}
                            <span><i class="fas fa-globe"></i> ${job.source || 'Job Board'}</span>
                        </div>
                        
                        ${job.description ? `
                            <div class="job-description">
                                ${job.description.substring(0, 200)}${job.description.length > 200 ? '...' : ''}
                            </div>
                        ` : ''}
                        
                        ${job.skills && job.skills.length > 0 ? `
                            <div class="job-skills">
                                <strong>Skills:</strong>
                                ${job.skills.slice(0, 5).map(skill => `<span class="skill-tag">${skill}</span>`).join('')}
                            </div>
                        ` : ''}
                        
                        <div class="job-actions">
                            ${job.url || job.link ? `
                                <a href="${job.url || job.link}" target="_blank" class="Button Button-primary">
                                    <i class="fas fa-external-link-alt"></i> Apply Now
                                </a>
                            ` : ''}
                            <button class="Button Button-secondary" onclick="saveJobForLater('${job.id || index}')">
                                <i class="fas fa-bookmark"></i> Save for Later
                            </button>
                            <button class="Button Button-info" onclick="analyzeJob('${job.url || job.link || ''}', '${encodeURIComponent(job.description || '')}')">
                                <i class="fas fa-chart-line"></i> Analyze Fit
                            </button>
                        </div>
                    </div>
                `;
            });

            html += `
                    <div class="search-tips">
                        <h4><i class="fas fa-lightbulb"></i> Tips for Better Results</h4>
                        <ul>
                            <li>Complete your profile and upload your resume for more accurate matching</li>
                            <li>Use specific job titles and skills in your search</li>
                            <li>Check back regularly as new jobs are added daily</li>
                            <li>Consider adjusting your location or remote work preferences</li>
                        </ul>
                    </div>
                </div>
            `;

            resultsContainer.innerHTML = html;
            resultsContainer.scrollIntoView({ behavior: 'smooth' });
        }

        async function saveJobSearchHistory(userId, searchParams, results) {
            try {
                const historyData = {
                    user_id: userId,
                    search_keywords: searchParams.keywords,
                    search_location: searchParams.location,
                    job_type: searchParams.jobType,
                    work_mode: searchParams.remote ? 'remote' : 'any',
                    results_count: results.count || 0,
                    search_date: new Date().toISOString()
                };

                // Save to job_searches table (create if doesn't exist)
                await window.supabase
                    .from('job_searches')
                    .insert([historyData]);
                    
                console.log('Job search history saved');
            } catch (error) {
                console.warn('Failed to save job search history:', error);
            }
        }

