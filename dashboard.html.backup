        <!-- Main Content -->
        <div class="main-content">
            <!-- Dashboard Sections -->
            <section id="dashboard" class="content-section active">
                <div class="section-header">
                    <h2>Welcome to Your Job Search Dashboard</h2>
                    <p>Track your applications, discover opportunities, and manage your job search journey.</p>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number" data-stat="active-applications">0</div>
                        <div class="stat-label">Active Applications</div>
