    <!-- Dashboard Footer -->
    <footer class="dashboard-footer">
        <div class="footer-content">
            <p>&copy; 2024 Jobsynt AI. All rights reserved.</p>
            <p>AI-powered job search with resume analysis, ghost job detection, and personalized recommendations.</p>
        </div>
    </footer>

<script>
        // Global navigation function
        function showSection(sectionId) {
            console.log('[Dashboard] Showing section:', sectionId);
            
            // Update active states for navigation links
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('data-section') === sectionId) {
                    link.classList.add('active');
                }
            });
            
            // Update active states for content sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
                if (section.id === sectionId) {
                    section.classList.add('active');
                    console.log('[Dashboard] Section activated:', sectionId);
                    
                    // Auto-populate forms when switching to certain sections
                    if (sectionId === 'ai-job-search') {
                        populateJobSearchForm();
                    }
                }
            });
        }

        // Auto-populate job search form with profile data
        async function populateJobSearchForm() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: profile } = await window.supabase
                    .from('profiles')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                if (profile) {
                    // Auto-fill job search form fields if they're empty
                    const jobTitle = document.getElementById('applicationPosition');
                    const visaField = document.getElementById('visa');
                    const salaryMin = document.getElementById('salaryMin');
                    const salaryMax = document.getElementById('salaryMax');

                    if (jobTitle && !jobTitle.value && profile.current_title) {
                        jobTitle.value = profile.current_title;
                    }
                    if (visaField && !visaField.value && profile.visa_status) {
                        visaField.value = profile.visa_status.toLowerCase().replace(' ', '_');
                    }
                    if (salaryMin && !salaryMin.value && profile.salary_range_from) {
                        salaryMin.value = profile.salary_range_from;
                    }
                    if (salaryMax && !salaryMax.value && profile.salary_range_to) {
                        salaryMax.value = profile.salary_range_to;
                    }

                    // Set employment status
                    if (profile.is_employed !== undefined) {
                        const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
                        employmentRadios.forEach(radio => {
                            if ((profile.is_employed && radio.value === 'employed') || 
                                (!profile.is_employed && radio.value === 'unemployed')) {
                                radio.checked = true;
                                radio.dispatchEvent(new Event('change'));
                            }
                        });
                    }

                    console.log('[Dashboard] Job search form auto-populated from profile');
                }
            } catch (error) {
                console.error('[Dashboard] Error auto-populating job search form:', error);
            }
        }

        // Robust navigation setup function
        function setupNavigation() {
            console.log('[Dashboard] Setting up navigation...');
            
            // Remove any existing event listeners by cloning nodes
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                const newLink = link.cloneNode(true);
                link.parentNode.replaceChild(newLink, link);
            });
            
            // Add fresh event listeners
            document.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Get the correct link element (in case user clicked on icon)
                    const linkElement = e.target.closest('.nav-link');
                    if (!linkElement) return;
                    
                    const section = linkElement.getAttribute('data-section');
                    
                    // Skip if no section (like sign out button)
                    if (!section) return;
                    
                    console.log('[Dashboard] Navigating to section:', section);
                    showSection(section);
                });
            });

            console.log('[Dashboard] Navigation setup complete');
        }

        // Initialize dashboard when DOM is loaded
        document.addEventListener('DOMContentLoaded', async () => {
            console.log('[Dashboard-HTML] DOM loaded, initializing...');
            
            // Prevent double initialization
            if (window.dashboardInitialized) {
                console.log('[Dashboard-HTML] Already initialized, skipping');
                return;
            }
            
            try {
                // Wait for Supabase to be available
                if (!window.supabase) {
                    console.error('[Dashboard] Supabase not initialized');
                    window.location.replace('/');
                    return;
                }

                // Check authentication
                const { data: { session }, error } = await window.supabase.auth.getSession();
                
                if (error) {
                    console.error('[Dashboard] Session error:', error);
                    window.location.replace('/');
                    return;
                }

                if (!session) {
                    console.log('[Dashboard] No valid session found');
                    window.location.replace('/');
                    return;
                }

                console.log('[Dashboard] Session valid, user:', session.user.email);
                
                // Set up auth state change listener
                window.supabase.auth.onAuthStateChange(async (event, session) => {
                    console.log('[Dashboard] Auth state changed:', event);
                    
                    if (event === 'SIGNED_OUT') {
                        console.log('[Dashboard] User signed out, redirecting');
                        window.location.replace('/');
                    }
                });

                // Set up navigation immediately - don't wait for dashboard.js
                setupNavigation();

                // Set up sign out handler
                const signOutButton = document.getElementById('signOutButton');
                if (signOutButton) {
                    signOutButton.addEventListener('click', async (e) => {
                        e.preventDefault();
                        try {
                            const { error } = await window.supabase.auth.signOut();
                            if (error) throw error;
                            window.location.replace('/');
                        } catch (error) {
                            console.error('[Dashboard] Error signing out:', error);
                            alert('Failed to sign out. Please try again.');
                        }
                    });
                }

                            // Initialize other dashboard components
            initializeEmploymentStatus();
            initializeResumeUpload();
            initializeJobSearch();
            initializeGhostDetector();
            initializeAddCompanyModal();
            initializeManualApplicationModal();
            initializeFloatingChat();
            initializeSettingsHandlers();
            initializeProfileForm();

                // Initialize dashboard data loading
                await initializeDashboardData();

                // Wait for dashboard.js to load (for additional features, but navigation already works)
                let retries = 0;
                const maxRetries = 10;
                
                const waitForDashboardJS = () => {
                    if (typeof loadProfileData !== 'undefined') {
                        console.log('[Dashboard-HTML] dashboard.js loaded, loading additional features...');
                        try {
                            // Load data if dashboard.js is available
                            if (typeof loadProfileData === 'function') loadProfileData();
                            if (typeof loadJobApplications === 'function') loadJobApplications();
                            if (typeof loadNetworkingContacts === 'function') loadNetworkingContacts();
                        } catch (error) {
                            console.error('[Dashboard] Error loading additional features:', error);
                        }
                    } else if (retries < maxRetries) {
                        retries++;
                        console.log(`[Dashboard-HTML] Waiting for dashboard.js... (${retries}/${maxRetries})`);
                        setTimeout(waitForDashboardJS, 100);
                    } else {
                        console.log('[Dashboard-HTML] dashboard.js not loaded, continuing with basic functionality');
                    }
                };
                
                waitForDashboardJS();
                
                window.dashboardInitialized = true;
                console.log('[Dashboard-HTML] Initialized successfully');
                
            } catch (error) {
                console.error('[Dashboard] Initialization error:', error);
                window.location.replace('/');
            }
        });

        function initializeResumeUpload() {
            const resumeUploadArea = document.getElementById('resumeUpload');
            const resumeInput = document.getElementById('resumeFile');
            const currentResume = document.getElementById('currentResume');
            
            if (resumeUploadArea && resumeInput) {
                resumeUploadArea.addEventListener('click', function() {
                    resumeInput.click();
                });
                
                // Handle drag and drop
                resumeUploadArea.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#667eea';
                    resumeUploadArea.style.backgroundColor = 'rgba(102, 126, 234, 0.05)';
                });
                
                resumeUploadArea.addEventListener('dragleave', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#ddd';
                    resumeUploadArea.style.backgroundColor = '';
                });
                
                resumeUploadArea.addEventListener('drop', function(e) {
                    e.preventDefault();
                    resumeUploadArea.style.borderColor = '#ddd';
                    resumeUploadArea.style.backgroundColor = '';
                    
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        resumeInput.files = files;
                        handleResumeUpload(files[0]);
                    }
                });
            }

            if (resumeInput) {
                resumeInput.addEventListener('change', function() {
                    if (this.files.length > 0) {
                        handleResumeUpload(this.files[0]);
                    }
                });
            }
            
            // Resume action buttons
            document.getElementById('viewResume')?.addEventListener('click', viewResume);
            document.getElementById('replaceResume')?.addEventListener('click', function() {
                if (resumeInput) {
                    resumeInput.value = ''; // Clear previous selection
                    resumeInput.click();
                }
            });
            document.getElementById('deleteResume')?.addEventListener('click', deleteResume);
        }

        async function handleResumeUpload(file) {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) throw new Error('Not authenticated');

                // Validate file type
                const allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
                if (!allowedTypes.includes(file.type)) {
                    throw new Error('Please upload a PDF or Word document');
                }

                // Validate file size (max 10MB)
                if (file.size > 10 * 1024 * 1024) {
                    throw new Error('File size must be less than 10MB');
                }

                const fileName = file.name;
                const fileSize = (file.size / (1024 * 1024)).toFixed(1) + ' MB';
                
                // Show upload progress
                showResumeUploadProgress();

                // Upload to Supabase Storage
                const fileExt = fileName.split('.').pop();
                const uniqueFileName = `${session.user.id}-${Date.now()}.${fileExt}`;
                const filePath = `${session.user.id}/${uniqueFileName}`;

                const { error: uploadError } = await window.supabase.storage
                    .from('resumes')
                    .upload(filePath, file, { upsert: true });

                if (uploadError) throw uploadError;

                // Get the public URL for the uploaded file
                const { data: urlData } = window.supabase.storage
                    .from('resumes')
                    .getPublicUrl(filePath);

                // Save resume info to database
                // Check if user already has a resume
                const { data: existingResume } = await window.supabase
                    .from('resumes')
                    .select('id, file_url')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                let dbError;
                if (existingResume) {
                    // Update existing resume
                    const updateResult = await window.supabase
                        .from('resumes')
                        .update({
                            file_name: fileName,
                            file_url: urlData.publicUrl,
                            file_size: file.size,
                            file_type: file.type,
                            is_primary: true,
                            uploaded_at: new Date().toISOString()
                        })
                        .eq('user_id', session.user.id);
                    
                    dbError = updateResult.error;

                    // Delete old file from storage if it exists and is different
                    if (existingResume.file_url && existingResume.file_url !== urlData.publicUrl) {
                        try {
                            const oldUrl = new URL(existingResume.file_url);
                            const oldFilePath = oldUrl.pathname.split('/').slice(-2).join('/');
                            await window.supabase.storage
                                .from('resumes')
                                .remove([oldFilePath]);
                        } catch (e) {
                            console.warn('Could not delete old resume file:', e);
                        }
                    }
                } else {
                    // Insert new resume
                    const insertResult = await window.supabase
                        .from('resumes')
                        .insert({
                            user_id: session.user.id,
                            file_name: fileName,
                            file_url: urlData.publicUrl,
                            file_size: file.size,
                            file_type: file.type,
                            is_primary: true,
                            uploaded_at: new Date().toISOString()
                        });
                    
                    dbError = insertResult.error;
                }

                if (dbError) throw dbError;

                // Update UI
                updateResumeUI(fileName, fileSize, new Date());
                hideResumeUploadProgress();
                
                const message = existingResume ? 'Resume updated successfully!' : 'Resume uploaded successfully!';
                alert(message);
                console.log('[Dashboard] Resume ' + (existingResume ? 'updated' : 'uploaded') + ':', urlData.publicUrl);

            } catch (error) {
                console.error('[Dashboard] Resume upload error:', error);
                hideResumeUploadProgress();
                
                let errorMessage = error.message;
                if (error.code === '23505') {
                    errorMessage = 'Resume update failed due to database constraint. Please try again or contact support.';
                } else if (error.message?.includes('storage')) {
                    errorMessage = 'File upload failed. Please check your internet connection and try again.';
                } else if (error.message?.includes('permission')) {
                    errorMessage = 'Permission denied. Please check your login status and try again.';
                }
                
                alert(`Resume upload failed: ${errorMessage}`);
            }
        }

        function updateResumeUI(fileName, fileSize, uploadTime) {
            const resumeUploadArea = document.getElementById('resumeUpload');
            const currentResume = document.getElementById('currentResume');
            
            if (resumeUploadArea) resumeUploadArea.style.display = 'none';
            if (currentResume) {
                currentResume.classList.remove('hidden');
                
                const nameEl = currentResume.querySelector('#resumeName');
                const timeEl = currentResume.querySelector('#uploadTime');
                
                if (nameEl) nameEl.textContent = fileName;
                if (timeEl) timeEl.textContent = uploadTime.toLocaleString();
            }
        }

        function showResumeUploadProgress() {
            // You can add a progress indicator here
            console.log('[Dashboard] Resume upload in progress...');
        }

        function hideResumeUploadProgress() {
            // Hide progress indicator
            console.log('[Dashboard] Resume upload progress hidden');
        }

        async function viewResume() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('file_url')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume && resume.file_url) {
                    window.open(resume.file_url, '_blank');
                }
            } catch (error) {
                console.error('[Dashboard] Error viewing resume:', error);
                alert('Error opening resume');
            }
        }

        async function deleteResume() {
            if (!confirm('Are you sure you want to delete your resume?')) return;

            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('file_url, id')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume) {
                    // Extract file path from URL for storage deletion
                    let filePath = null;
                    if (resume.file_url) {
                        try {
                            const url = new URL(resume.file_url);
                            filePath = url.pathname.split('/').slice(-2).join('/'); // Get last two parts (user_id/filename)
                        } catch (e) {
                            console.warn('Could not extract file path from URL:', resume.file_url);
                        }
                    }

                    // Delete from storage if we have a file path
                    if (filePath) {
                        await window.supabase.storage
                            .from('resumes')
                            .remove([filePath]);
                    }

                    // Delete from database
                    await window.supabase
                        .from('resumes')
                        .delete()
                        .eq('id', resume.id);

                    // Reset UI
                    const resumeUploadArea = document.getElementById('resumeUpload');
                    const currentResume = document.getElementById('currentResume');
                    
                    if (resumeUploadArea) resumeUploadArea.style.display = 'block';
                    if (currentResume) currentResume.classList.add('hidden');

                    alert('Resume deleted successfully');
                }
            } catch (error) {
                console.error('[Dashboard] Error deleting resume:', error);
                alert('Error deleting resume');
            }
        }

        function initializeJobSearch() {
            const jobSearchForm = document.getElementById('jobSearchForm');
            
            if (jobSearchForm) {
                jobSearchForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    try {
                        // Get form data
                        const formData = new FormData(this);
                        const searchType = document.querySelector('input[name="searchType"]:checked')?.value || 'jobs';
                        const searchParams = {
                            keywords: document.getElementById('applicationPosition')?.value || '',
                            location: '', // Will be derived from profile
                            remote: document.getElementById('workMode')?.value === 'remote',
                            jobType: document.getElementById('jobType')?.value || 'full-time',
                            visa_status: document.getElementById('visa')?.value || '',
                            salary_range: {
                                min: parseInt(document.getElementById('salaryMin')?.value || '0'),
                                max: parseInt(document.getElementById('salaryMax')?.value || '0')
                            },
                            country: 'usa', // Default, could be enhanced to detect from profile
                            search_type: searchType
                        };

                        // Get user profile for better matching
                        const { data: { session } } = await window.supabase.auth.getSession();
                        if (session) {
                            const { data: profile } = await window.supabase
                                .from('profiles')
                                .select('*')
                                .eq('user_id', session.user.id)
                                .maybeSingle();

                            if (profile) {
                                // Add profile data to search params
                                searchParams.skills = profile.skills ? profile.skills.split(',').map(s => s.trim()) : [];
                                searchParams.experience_level = profile.experience_level || 'entry';
                                searchParams.linkedin_url = profile.linkedin_url || '';
                                if (profile.city && profile.state) {
                                    searchParams.location = `${profile.city}, ${profile.state}`;
                                }
                            }
                        }

                        // Show loading state
                        const submitButton = this.querySelector('button[type="submit"]');
                        const originalText = submitButton.innerHTML;
                        submitButton.innerHTML = '<span class="loading"></span> Searching for your perfect jobs...';
                        submitButton.disabled = true;
                        
                        try {
                            // Call the job scraper
                            const response = await fetch('/.netlify/functions/job-scraper', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify(searchParams)
                            });

                            if (!response.ok) {
                                throw new Error(`Job search failed: ${response.status}`);
                            }

                            const result = await response.json();
                            
                            if (result.success && (result.jobs || result.apprenticeships)) {
                                // Display results based on search type
                                if (searchType === 'apprenticeships') {
                                    displayApprenticeshipResults(result);
                                } else {
                                    displayJobSearchResults(result);
                                }
                                
                                // Save search to user's history (optional)
                                if (session) {
                                    await saveJobSearchHistory(session.user.id, searchParams, result);
                                }
                            } else {
                                throw new Error(result.error || `No ${searchType} found`);
                            }
                            
                        } catch (searchError) {
                            console.error('Job search error:', searchError);
                            
                            // Show error message
                            const resultsContainer = document.querySelector('.search-results');
                            if (resultsContainer) {
                                resultsContainer.innerHTML = `
                                    <div class="alert alert-warning">
                                        <h4><i class="fas fa-exclamation-triangle"></i> Search Temporarily Unavailable</h4>
                                        <p>We're having trouble searching for jobs right now. Please try again in a few minutes.</p>
                                        <p><strong>Error:</strong> ${searchError.message}</p>
                                    </div>
                                `;
                            }
                        }
                        
                        // Restore button
                        submitButton.innerHTML = originalText;
                        submitButton.disabled = false;
                        
                    } catch (error) {
                        console.error('Form submission error:', error);
                        alert(`Error: ${error.message}`);
                        
                        // Restore button
                        const submitButton = this.querySelector('button[type="submit"]');
                        if (submitButton) {
                            submitButton.innerHTML = '<i class="fas fa-search"></i> Find My Perfect Jobs';
                            submitButton.disabled = false;
                        }
                    }
                });
            }
        }

        function displayJobSearchResults(result) {
            const resultsContainer = document.querySelector('.search-results');
            if (!resultsContainer) return;

            if (!result.jobs || result.jobs.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="alert alert-info">
                        <h4><i class="fas fa-info-circle"></i> No Jobs Found</h4>
                        <p>We couldn't find any jobs matching your criteria. Try adjusting your search parameters.</p>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="job-search-results">
                    <div class="results-header">
                        <h3><i class="fas fa-briefcase"></i> Found ${result.count} Perfect Job Matches</h3>
                        <div class="search-stats">
                            <p>✅ ${result.total_found} total jobs found</p>
                            <p>🚫 ${result.filtered_ghost} ghost jobs filtered out</p>
                            <p>📊 Showing top ${result.count} matches based on your profile</p>
                        </div>
                    </div>
            `;

            result.jobs.forEach((job, index) => {
                const matchScore = job.profileMatch || job.match_score || Math.floor(Math.random() * 20) + 80; // Default high score
                const isGhost = job.is_ghost || false;
                const ghostScore = job.ghost_score || 0;
                
                html += `
                    <div class="job-card ${isGhost ? 'ghost-job' : 'legitimate-job'}">
                        <div class="job-header">
                            <div class="job-info">
                                <h4 class="job-title">${job.title || 'Unknown Position'}</h4>
                                <div class="job-company">${job.company || 'Unknown Company'}</div>
                                <div class="job-location">
                                    <i class="fas fa-map-marker-alt"></i> ${job.location || 'Location not specified'}
                                    ${job.remote ? '<span class="remote-badge">Remote</span>' : ''}
                                </div>
                            </div>
                            <div class="job-scores">
                                <div class="match-score ${getScoreClass(matchScore)}">
                                    ${matchScore}% Match
                                </div>
                                ${!isGhost ? '<div class="verified-badge">✅ Verified</div>' : `<div class="ghost-badge">👻 ${ghostScore}% Risk</div>`}
                            </div>
                        </div>
                        
                        <div class="job-meta">
                            <span><i class="fas fa-clock"></i> ${job.posted || job.posted_date || 'Recently posted'}</span>
                            <span><i class="fas fa-briefcase"></i> ${job.type || 'Full-time'}</span>
                            ${job.salary ? `<span><i class="fas fa-dollar-sign"></i> ${job.salary}</span>` : ''}
                            <span><i class="fas fa-globe"></i> ${job.source || 'Job Board'}</span>
                        </div>
                        
                        ${job.description ? `
                            <div class="job-description">
                                ${job.description.substring(0, 200)}${job.description.length > 200 ? '...' : ''}
                            </div>
                        ` : ''}
                        
                        ${job.skills && job.skills.length > 0 ? `
                            <div class="job-skills">
                                <strong>Skills:</strong>
                                ${job.skills.slice(0, 5).map(skill => `<span class="skill-tag">${skill}</span>`).join('')}
                            </div>
                        ` : ''}
                        
                        <div class="job-actions">
                            ${job.url || job.link ? `
                                <a href="${job.url || job.link}" target="_blank" class="Button Button-primary">
                                    <i class="fas fa-external-link-alt"></i> Apply Now
                                </a>
                            ` : ''}
                            <button class="Button Button-secondary" onclick="saveJobForLater('${job.id || index}')">
                                <i class="fas fa-bookmark"></i> Save for Later
                            </button>
                            <button class="Button Button-info" onclick="analyzeJob('${job.url || job.link || ''}', '${encodeURIComponent(job.description || '')}')">
                                <i class="fas fa-chart-line"></i> Analyze Fit
                            </button>
                        </div>
                    </div>
                `;
            });

            html += `
                    <div class="search-tips">
                        <h4><i class="fas fa-lightbulb"></i> Tips for Better Results</h4>
                        <ul>
                            <li>Complete your profile and upload your resume for more accurate matching</li>
                            <li>Use specific job titles and skills in your search</li>
                            <li>Check back regularly as new jobs are added daily</li>
                            <li>Consider adjusting your location or remote work preferences</li>
                        </ul>
                    </div>
                </div>
            `;

            resultsContainer.innerHTML = html;
            resultsContainer.scrollIntoView({ behavior: 'smooth' });
        }

        async function saveJobSearchHistory(userId, searchParams, results) {
            try {
                const historyData = {
                    user_id: userId,
                    search_keywords: searchParams.keywords,
                    search_location: searchParams.location,
                    job_type: searchParams.jobType,
                    work_mode: searchParams.remote ? 'remote' : 'any',
                    results_count: results.count || 0,
                    search_date: new Date().toISOString()
                };

                // Save to job_searches table (create if doesn't exist)
                await window.supabase
                    .from('job_searches')
                    .insert([historyData]);
                    
                console.log('Job search history saved');
            } catch (error) {
                console.warn('Failed to save job search history:', error);
            }
        }

        function saveJobForLater(jobId) {
            // Placeholder for save job functionality
            alert('Job saved for later! (Feature coming soon)');
        }

        function analyzeJob(jobUrl, jobDescription) {
            // Navigate to AI Resume Assistant and pre-fill the job analysis form
            showSection('ai-resume');
            
            setTimeout(() => {
                const urlField = document.getElementById('jobUrlAnalysis');
                const descField = document.getElementById('jobDescriptionPreview');
                
                if (urlField && jobUrl) {
                    urlField.value = jobUrl;
                }
                if (descField && jobDescription) {
                    descField.value = decodeURIComponent(jobDescription);
                }
                
                // Scroll to the form
                document.getElementById('jobAnalysisForm')?.scrollIntoView({ behavior: 'smooth' });
            }, 500);
        }

        function initializeEmploymentStatus() {
            // Employment status toggle in AI Job Search
            const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
            const unemployedSection = document.getElementById('unemployedSection');
            
            if (employmentRadios.length > 0 && unemployedSection) {
                employmentRadios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.value === 'unemployed') {
                            unemployedSection.style.display = 'block';
                        } else {
                            unemployedSection.style.display = 'none';
                        }
                    });
                });
            }
        }

        function initializeAddCompanyModal() {
            const addCompanyBtn = document.getElementById('addCompanyBtn');
            const modal = document.getElementById('addCompanyModal');
            const closeModal = modal?.querySelector('.close-modal');
            const form = document.getElementById('addCompanyForm');

            if (addCompanyBtn && modal) {
                addCompanyBtn.addEventListener('click', function() {
                    modal.style.display = 'flex';
                });

                if (closeModal) {
                    closeModal.addEventListener('click', function() {
                        modal.style.display = 'none';
                    });
                }

                // Close modal when clicking outside
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });

                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        
                        try {
                            const { data: { session } } = await window.supabase.auth.getSession();
                            if (!session) return;

                            const companyData = {
                                name: document.getElementById('companyName').value,
                                website: document.getElementById('companyWebsite').value,
                                linkedin_url: document.getElementById('companyLinkedIn').value,
                                headquarters: document.getElementById('companyLocation').value,
                                description: document.getElementById('companyReason').value,
                                created_at: new Date().toISOString(),
                                updated_at: new Date().toISOString()
                            };

                            // First, insert or get the company
                            const { data: existingCompany, error: checkError } = await window.supabase
                                .from('companies')
                                .select('id')
                                .eq('name', companyData.name)
                                .eq('website', companyData.website)
                                .limit(1);

                            let companyId;

                            if (existingCompany && existingCompany.length > 0) {
                                companyId = existingCompany[0].id;
                            } else {
                                // Insert new company
                                const { data: newCompany, error: insertError } = await window.supabase
                                    .from('companies')
                                    .insert([companyData])
                                    .select('id')
                                    .single();

                                if (insertError) throw insertError;
                                companyId = newCompany.id;
                            }

                            // Create user-company relationship
                            const userCompanyData = {
                                user_id: session.user.id,
                                company_id: companyId,
                                preferred_location: document.getElementById('companyLocation').value,
                                reason: document.getElementById('companyReason').value,
                                created_at: new Date().toISOString(),
                                updated_at: new Date().toISOString()
                            };

                            const { error: relationError } = await window.supabase
                                .from('user_companies')
                                .insert([userCompanyData]);

                            if (relationError) throw relationError;

                            console.log('Company added successfully to favorites');
                            alert('Company added successfully to your favorites!');
                            modal.style.display = 'none';
                            form.reset();
                            
                            // Refresh the companies list
                            loadFavoriteCompanies();
                        } catch (error) {
                            console.error('Error adding company:', error);
                            alert('Error adding company. Please try again.');
                        }
                    });
                }
            }
        }

        function initializeManualApplicationModal() {
            const addManualApplicationBtn = document.getElementById('addManualApplicationBtn');
            const modal = document.getElementById('addManualApplicationModal');
            const closeModal = modal?.querySelector('.close-modal');
            const form = document.getElementById('addManualApplicationForm');

            // Set today's date as default
            const dateField = document.getElementById('manualApplicationDate');
            if (dateField) {
                dateField.value = new Date().toISOString().split('T')[0];
            }

            if (addManualApplicationBtn && modal) {
                addManualApplicationBtn.addEventListener('click', function() {
                    modal.style.display = 'flex';
                });

                if (closeModal) {
                    closeModal.addEventListener('click', function() {
                        modal.style.display = 'none';
                    });
                }

                // Close modal when clicking outside
                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        modal.style.display = 'none';
                    }
                });

                if (form) {
                    form.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        
                        try {
                            const { data: { session } } = await window.supabase.auth.getSession();
                            if (!session) return;

                            const applicationData = {
                                user_id: session.user.id,
                                job_title: document.getElementById('manualJobTitle').value,
                                job_url: document.getElementById('manualJobUrl').value || null,
                                job_description: document.getElementById('manualJobDescription').value || null,
                                application_date: document.getElementById('manualApplicationDate').value,
                                notes: document.getElementById('manualNotes').value || null,
                                status: 'applied',
                                created_at: new Date().toISOString(),
                                updated_at: new Date().toISOString()
                            };

                            // First, get or create company
                            const companyName = document.getElementById('manualCompanyName').value;
                            let companyId = null;

                            const { data: existingCompany } = await window.supabase
                                .from('companies')
                                .select('id')
                                .eq('name', companyName)
                                .maybeSingle();

                            if (existingCompany) {
                                companyId = existingCompany.id;
                            } else {
                                const { data: newCompany, error: companyError } = await window.supabase
                                    .from('companies')
                                    .insert([{
                                        name: companyName,
                                        created_at: new Date().toISOString(),
                                        updated_at: new Date().toISOString()
                                    }])
                                    .select('id')
                                    .single();

                                if (companyError) throw companyError;
                                companyId = newCompany.id;
                            }

                            applicationData.company_id = companyId;

                            // Insert application
                            const { error } = await window.supabase
                                .from('job_applications')
                                .insert([applicationData]);

                            if (error) throw error;

                            alert('Application added successfully to your tracker!');
                            modal.style.display = 'none';
                            form.reset();
                            
                            // Reset date to today
                            if (dateField) {
                                dateField.value = new Date().toISOString().split('T')[0];
                            }
                            
                            // Refresh applications list
                            loadJobApplications();
                        } catch (error) {
                            console.error('Error adding manual application:', error);
                            alert('Error adding application. Please try again.');
                        }
                    });
                }
            }
        }

        function initializeFloatingChat() {
            const floatingBtn = document.getElementById('floatingChatButton');
            const floatingWindow = document.getElementById('floatingChatWindow');
            const closeChat = floatingWindow?.querySelector('.close-chat');
            const sendBtn = document.getElementById('sendMessage');
            const chatInput = document.getElementById('chatInput');

            if (floatingBtn && floatingWindow) {
                floatingBtn.addEventListener('click', function() {
                    floatingWindow.classList.toggle('hidden');
                });

                if (closeChat) {
                    closeChat.addEventListener('click', function() {
                        floatingWindow.classList.add('hidden');
                    });
                }

                if (sendBtn && chatInput) {
                    const sendMessage = async () => {
                        const message = chatInput.value.trim();
                        if (!message) return;

                        // Add user message to chat
                        addChatMessage(message, 'user');
                        chatInput.value = '';

                        // Show typing indicator
                        const typingDiv = document.createElement('div');
                        typingDiv.className = 'chat-message ai-message typing-indicator';
                        typingDiv.innerHTML = `
                            <div class="message-content">
                                <div class="message-avatar">
                                    <i class="fas fa-robot"></i>
                                </div>
                                <div class="message-text">
                                    <i class="fas fa-spinner fa-spin"></i> Thinking...
                                </div>
                            </div>
                        `;
                        const chatMessages = document.querySelector('#floatingChatWindow .chat-messages');
                        if (chatMessages) {
                            chatMessages.appendChild(typingDiv);
                            chatMessages.scrollTop = chatMessages.scrollHeight;
                        }

                        try {
                            // Get AI response
                            const aiResponse = await sendMessageToGPT(message, false);
                            
                            // Remove typing indicator
                            typingDiv.remove();
                            
                            // Add AI response
                            addChatMessage(aiResponse, 'ai');
                        } catch (error) {
                            // Remove typing indicator
                            typingDiv.remove();
                            
                            // Add error message
                            addChatMessage('Sorry, I encountered an error. Please try again.', 'ai');
                        }
                    };

                    sendBtn.addEventListener('click', sendMessage);
                    chatInput.addEventListener('keypress', function(e) {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            sendMessage();
                        }
                    });
                }
            }
        }

        function addChatMessage(message, sender, targetContainer = null) {
            const chatMessages = targetContainer || document.querySelector('#floatingChatWindow .chat-messages');
            if (!chatMessages) return;

            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${sender}-message`;
            
            const time = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            messageDiv.innerHTML = `
                <div class="message-content">
                    <div class="message-avatar">
                        <i class="fas fa-${sender === 'user' ? 'user' : 'robot'}"></i>
                    </div>
                    <div class="message-text">${message}</div>
                </div>
                <div class="message-time">${time}</div>
            `;

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Enhanced GPT Integration for Career Assistance
        async function sendMessageToGPT(message, isCareerChat = false) {
            try {
                // Get user profile and resume data for context
                const userProfileData = await getUserProfileForGPT();
                
                const systemPrompt = `You are an AI career assistant for Jobsynt, a job search platform. You have access to the user's complete profile and resume. 

User Profile Context:
${userProfileData ? JSON.stringify(userProfileData.profile, null, 2) : 'Profile not available'}

Resume Available: ${userProfileData?.resume ? 'Yes (' + userProfileData.resume.fileName + ')' : 'No'}

Instructions:
- Provide personalized career advice based on their profile
- Help with job search strategies, interview preparation, resume optimization
- Suggest networking approaches based on their target companies
- Be supportive and professional
- Keep responses concise but helpful
- If they ask about jobs, remind them to check the AI Job Search section`;

                // This would integrate with your GPT API
                // For now, return a contextual response
                const response = await generateAIResponse(message, systemPrompt, userProfileData);
                return response;
                
            } catch (error) {
                console.error('Error communicating with GPT:', error);
                return "I'm sorry, I'm having trouble processing your request right now. Please try again later.";
            }
        }

        async function generateAIResponse(message, systemPrompt, userContext) {
            // This is where you'd integrate with OpenAI API
            // For now, providing contextual responses based on user profile
            
            const lowerMessage = message.toLowerCase();
            const profile = userContext?.profile;
            const hasResume = !!userContext?.resume;
            
            if (lowerMessage.includes('job') || lowerMessage.includes('position')) {
                if (profile?.current_title) {
                    return `Based on your profile as a ${profile.current_title}, I can help you find relevant opportunities. Check out the AI Job Search section where I analyze your skills and match you with perfect jobs. What specific type of role are you looking for?`;
                } else {
                    return "I'd love to help you with job search! First, make sure to complete your profile and upload your resume. This helps me provide personalized job recommendations. What type of position interests you?";
                }
            }
            
            if (lowerMessage.includes('resume')) {
                if (hasResume) {
                    return "Great! I can see you have a resume uploaded. I can help you optimize it for specific jobs or provide general feedback. Would you like me to analyze it for ATS compatibility or suggest improvements for specific roles?";
                } else {
                    return "I notice you haven't uploaded a resume yet. This is crucial for job matching! Please upload your resume in the AI Resume Assistant section, and I'll help you optimize it for better job matches.";
                }
            }
            
            if (lowerMessage.includes('interview')) {
                return `I can help you prepare for interviews! ${profile?.current_title ? `As a ${profile.current_title},` : ''} here are some tips: Practice STAR method responses, research the company thoroughly, prepare questions about the role and team. Would you like specific interview questions for your field?`;
            }
            
            if (lowerMessage.includes('network')) {
                return "Networking is key to job success! Check out the Network Recommendations section where I suggest relevant professionals from your target companies. Would you like tips on how to approach them or craft connection messages?";
            }
            
            if (lowerMessage.includes('salary')) {
                if (profile?.salary_range_from) {
                    return `Based on your profile with a target range of $${profile.salary_range_from}${profile.salary_range_to ? `-$${profile.salary_range_to}` : '+'}, I can help you negotiate effectively. Research market rates, highlight your unique value, and consider the total compensation package. Need help with salary negotiation strategies?`;
                } else {
                    return "Salary negotiation is important! First, complete your salary expectations in your profile. Then I can provide personalized advice based on your experience level and location. What's your current situation?";
                }
            }
            
            // Default helpful response
            return `Hello! I'm here to help with your career journey. I can assist with job searching, resume optimization, interview preparation, networking strategies, and more. ${profile?.first_name ? `${profile.first_name}, ` : ''}what would you like to work on today?`;
        }

        function initializeSettingsHandlers() {
            const resetBtn = document.getElementById('resetAccount');
            const downloadBtn = document.getElementById('downloadProfileData');

            if (resetBtn) {
                resetBtn.addEventListener('click', async function() {
                    if (confirm('Are you sure you want to reset all your account data? This cannot be undone.')) {
                        if (confirm('This will delete all your profile data, applications, and preferences. Type "RESET" to confirm.')) {
                            // TODO: Implement reset functionality
                            console.log('Resetting account data...');
                            alert('Account data has been reset successfully.');
                        }
                    }
                });
            }

            if (downloadBtn) {
                downloadBtn.addEventListener('click', async function() {
                    try {
                        // TODO: Get actual data from Supabase
                        const profileData = {
                            profile: 'User profile data...',
                            applications: 'Job applications...',
                            preferences: 'User preferences...',
                            exportDate: new Date().toISOString()
                        };

                        const dataStr = JSON.stringify(profileData, null, 2);
                        const dataBlob = new Blob([dataStr], {type: 'application/json'});
                        const url = URL.createObjectURL(dataBlob);
                        
                        const link = document.createElement('a');
                        link.href = url;
                        link.download = `jobsynt-profile-data-${new Date().toISOString().split('T')[0]}.json`;
                        link.click();
                        
                        URL.revokeObjectURL(url);
                    } catch (error) {
                        console.error('Error downloading profile data:', error);
                        alert('Error downloading profile data. Please try again.');
                    }
                });
            }
        }

        function initializeGhostDetector() {
            const ghostDetectorForm = document.getElementById('ghostDetectorForm');
            
            if (ghostDetectorForm) {
                ghostDetectorForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const jobUrl = document.getElementById('jobUrl').value;
                    const jobDescription = document.getElementById('jobDescriptionInput').value;
                    
                    const submitButton = this.querySelector('button[type="submit"]');
                    const submitText = submitButton.querySelector('.submit-text');
                    const loadingSpinner = submitButton.querySelector('.loading-spinner');
                    
                    if (submitText && loadingSpinner) {
                        submitText.style.display = 'none';
                        loadingSpinner.style.display = 'inline-block';
                        submitButton.disabled = true;
                        
                        try {
                            // Analyze the job posting
                            const analysisResult = await analyzeJobPosting(jobUrl, jobDescription);
                            
                            // Restore button
                            submitText.style.display = 'inline-block';
                            loadingSpinner.style.display = 'none';
                            submitButton.disabled = false;
                            
                            // Show results
                            displayGhostJobResults(analysisResult);
                            
                        } catch (error) {
                            console.error('Ghost job analysis error:', error);
                            submitText.style.display = 'inline-block';
                            loadingSpinner.style.display = 'none';
                            submitButton.disabled = false;
                            alert('Error analyzing job posting. Please try again.');
                        }
                    }
                });
            }
        }

        async function analyzeJobPosting(jobUrl, jobDescription) {
            // This would integrate with your ghost job detection API
            // For now, providing a realistic analysis based on common patterns
            
            const redFlags = [];
            let riskScore = 0;
            
            // Analyze URL patterns
            if (jobUrl) {
                if (jobUrl.includes('linkedin.com') && jobUrl.includes('/jobs/view/')) {
                    riskScore -= 10; // LinkedIn posts are generally more reliable
                } else if (jobUrl.includes('indeed.com')) {
                    riskScore += 5; // Indeed can have more ghost jobs
                }
            }
            
            // Analyze job description
            if (jobDescription) {
                const description = jobDescription.toLowerCase();
                
                // Check for vague descriptions
                if (description.length < 200) {
                    redFlags.push("Very short job description");
                    riskScore += 15;
                }
                
                // Check for generic keywords
                const genericTerms = ['rockstar', 'ninja', 'guru', 'unicorn', 'highly motivated'];
                const foundGeneric = genericTerms.filter(term => description.includes(term));
                if (foundGeneric.length > 0) {
                    redFlags.push(`Generic buzzwords found: ${foundGeneric.join(', ')}`);
                    riskScore += 10;
                }
                
                // Check for unrealistic requirements
                if (description.includes('entry level') && description.includes('5+ years')) {
                    redFlags.push("Contradictory experience requirements");
                    riskScore += 20;
                }
                
                // Check for missing salary information
                if (!description.includes('salary') && !description.includes('compensation') && !description.includes('$')) {
                    redFlags.push("No salary or compensation mentioned");
                    riskScore += 5;
                }
            }
            
            // Simulate additional checks
            riskScore += Math.floor(Math.random() * 10); // Random factor
            
            // Determine risk level
            let riskLevel, riskColor;
            if (riskScore < 20) {
                riskLevel = 'Low';
                riskColor = 'low';
            } else if (riskScore < 50) {
                riskLevel = 'Medium';
                riskColor = 'medium';
            } else {
                riskLevel = 'High';
                riskColor = 'high';
            }
            
            return {
                riskScore: Math.min(riskScore, 85), // Cap at 85%
                riskLevel,
                riskColor,
                redFlags,
                recommendations: generateRecommendations(riskLevel, redFlags)
            };
        }

        function generateRecommendations(riskLevel, redFlags) {
            const recommendations = [];
            
            if (riskLevel === 'High') {
                recommendations.push("❌ High risk of ghost job - consider avoiding");
                recommendations.push("🔍 Research company thoroughly before applying");
                recommendations.push("📞 Try to contact the company directly");
            } else if (riskLevel === 'Medium') {
                recommendations.push("⚠️ Proceed with caution");
                recommendations.push("🔍 Research the company and role thoroughly");
                recommendations.push("📧 Consider reaching out to current employees");
            } else {
                recommendations.push("✅ Relatively safe to apply");
                recommendations.push("📝 Tailor your application to the specific requirements");
                recommendations.push("🤝 Consider networking with company employees");
            }
            
            return recommendations;
        }

        function displayGhostJobResults(result) {
            const resultsContainer = document.querySelector('.ghost-detector-results');
            if (!resultsContainer) return;
            
            resultsContainer.innerHTML = `
                <div class="card ${result.riskColor}-risk">
                    <div class="card-header">
                        <h3>Ghost Job Analysis Results</h3>
                    </div>
                    <div class="analysis-content">
                        <div class="score-display ${result.riskColor}">
                            <div class="ghost-score ${result.riskColor}">
                                Risk Score: ${result.riskScore}% (${result.riskLevel})
                            </div>
                        </div>
                        
                        ${result.redFlags.length > 0 ? `
                            <div class="red-flags">
                                <h4>🚩 Red Flags Detected:</h4>
                                <ul>
                                    ${result.redFlags.map(flag => `<li>${flag}</li>`).join('')}
                                </ul>
                            </div>
                        ` : '<div class="alert alert-success">✅ No major red flags detected!</div>'}
                        
                        <div class="recommendations">
                            <h4>💡 Recommendations:</h4>
                            <ul>
                                ${result.recommendations.map(rec => `<li>${rec}</li>`).join('')}
                            </ul>
                        </div>
                        
                        <div class="analysis-footer">
                            <p><small><i class="fas fa-info-circle"></i> Analysis based on 12+ ghost job indicators including posting patterns, description quality, and company verification.</small></p>
                        </div>
                    </div>
                </div>
            `;
            
            // Scroll to results
            resultsContainer.scrollIntoView({ behavior: 'smooth' });
        }

