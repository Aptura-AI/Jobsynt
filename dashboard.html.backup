  padding-bottom: 15px;
  border-bottom: 1px solid #eee;
}

.form-group {
  margin-bottom: 15px;
}

.form-check {
  margin-bottom: 10px;
}

#stateGroup, #otherVisaGroup, #unemployedSinceGroup {
  transition: all 0.3s ease;
}

.radio-inline {
  display: inline-flex;
  align-items: center;
  margin-right: 20px;
  cursor: pointer;
}

.radio-inline input[type="radio"] {
  margin-right: 8px;
}
</style>

