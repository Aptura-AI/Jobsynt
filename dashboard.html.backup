                            if (existingCompany) {
                                companyId = existingCompany.id;
                            } else {
                                const { data: newCompany, error: companyError } = await window.supabase
                                    .from('companies')
                                    .insert([{
                                        name: companyName,
                                        created_at: new Date().toISOString(),
                                        updated_at: new Date().toISOString()
                                    }])
                                    .select('id')
                                    .single();

                                if (companyError) throw companyError;
                                companyId = newCompany.id;
                            }

                            applicationData.company_id = companyId;

                            // Insert application
                            const { error } = await window.supabase
                                .from('job_applications')
                                .insert([applicationData]);

                            if (error) throw error;

                            alert('Application added successfully to your tracker!');
                            modal.style.display = 'none';
                            form.reset();
                            
                            // Reset date to today
                            if (dateField) {
                                dateField.value = new Date().toISOString().split('T')[0];
                            }
                            
                            // Refresh applications list
                            loadJobApplications();
                        } catch (error) {
                            console.error('Error adding manual application:', error);
                            alert('Error adding application. Please try again.');
                        }
                    });
                }
            }
        }

        function initializeFloatingChat() {
            const floatingBtn = document.getElementById('floatingChatButton');
            const floatingWindow = document.getElementById('floatingChatWindow');
            const closeChat = floatingWindow?.querySelector('.close-chat');
            const sendBtn = document.getElementById('sendMessage');
            const chatInput = document.getElementById('chatInput');

            if (floatingBtn && floatingWindow) {
                floatingBtn.addEventListener('click', function() {
                    floatingWindow.classList.toggle('hidden');
                });

                if (closeChat) {
                    closeChat.addEventListener('click', function() {
                        floatingWindow.classList.add('hidden');
                    });
                }

                if (sendBtn && chatInput) {
                    const sendMessage = async () => {
                        const message = chatInput.value.trim();
                        if (!message) return;

                        // Add user message to chat
                        addChatMessage(message, 'user');
                        chatInput.value = '';

                        // Show typing indicator
                        const typingDiv = document.createElement('div');
                        typingDiv.className = 'chat-message ai-message typing-indicator';
                        typingDiv.innerHTML = `
                            <div class="message-content">
                                <div class="message-avatar">
                                    <i class="fas fa-robot"></i>
                                </div>
                                <div class="message-text">
                                    <i class="fas fa-spinner fa-spin"></i> Thinking...
                                </div>
                            </div>
                        `;
                        const chatMessages = document.querySelector('#floatingChatWindow .chat-messages');
                        if (chatMessages) {
                            chatMessages.appendChild(typingDiv);
                            chatMessages.scrollTop = chatMessages.scrollHeight;
                        }

                        try {
                            // Get AI response
                            const aiResponse = await sendMessageToGPT(message, false);
                            
                            // Remove typing indicator
                            typingDiv.remove();
                            
                            // Add AI response
                            addChatMessage(aiResponse, 'ai');
                        } catch (error) {
                            // Remove typing indicator
                            typingDiv.remove();
                            
                            // Add error message
                            addChatMessage('Sorry, I encountered an error. Please try again.', 'ai');
                        }
                    };

                    sendBtn.addEventListener('click', sendMessage);
                    chatInput.addEventListener('keypress', function(e) {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            sendMessage();
                        }
                    });
                }
            }
        }

        function addChatMessage(message, sender, targetContainer = null) {
            const chatMessages = targetContainer || document.querySelector('#floatingChatWindow .chat-messages');
            if (!chatMessages) return;

            const messageDiv = document.createElement('div');
            messageDiv.className = `chat-message ${sender}-message`;
            
            const time = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            messageDiv.innerHTML = `
                <div class="message-content">
                    <div class="message-avatar">
                        <i class="fas fa-${sender === 'user' ? 'user' : 'robot'}"></i>
                    </div>
                    <div class="message-text">${message}</div>
                </div>
                <div class="message-time">${time}</div>
            `;

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Enhanced GPT Integration for Career Assistance
        async function sendMessageToGPT(message, isCareerChat = false) {
            try {
                // Get user profile and resume data for context
                const userProfileData = await getUserProfileForGPT();
                
                const systemPrompt = `You are an AI career assistant for Jobsynt, a job search platform. You have access to the user's complete profile and resume. 

User Profile Context:
${userProfileData ? JSON.stringify(userProfileData.profile, null, 2) : 'Profile not available'}

Resume Available: ${userProfileData?.resume ? 'Yes (' + userProfileData.resume.fileName + ')' : 'No'}

Instructions:
- Provide personalized career advice based on their profile
- Help with job search strategies, interview preparation, resume optimization
- Suggest networking approaches based on their target companies
- Be supportive and professional
- Keep responses concise but helpful
- If they ask about jobs, remind them to check the AI Job Search section`;

                // This would integrate with your GPT API
                // For now, return a contextual response
                const response = await generateAIResponse(message, systemPrompt, userProfileData);
                return response;
                
            } catch (error) {
                console.error('Error communicating with GPT:', error);
                return "I'm sorry, I'm having trouble processing your request right now. Please try again later.";
            }
        }

        async function generateAIResponse(message, systemPrompt, userContext) {
            // This is where you'd integrate with OpenAI API
            // For now, providing contextual responses based on user profile
            
            const lowerMessage = message.toLowerCase();
            const profile = userContext?.profile;
            const hasResume = !!userContext?.resume;
            
            if (lowerMessage.includes('job') || lowerMessage.includes('position')) {
                if (profile?.current_title) {
                    return `Based on your profile as a ${profile.current_title}, I can help you find relevant opportunities. Check out the AI Job Search section where I analyze your skills and match you with perfect jobs. What specific type of role are you looking for?`;
                } else {
                    return "I'd love to help you with job search! First, make sure to complete your profile and upload your resume. This helps me provide personalized job recommendations. What type of position interests you?";
                }
            }
            
            if (lowerMessage.includes('resume')) {
                if (hasResume) {
                    return "Great! I can see you have a resume uploaded. I can help you optimize it for specific jobs or provide general feedback. Would you like me to analyze it for ATS compatibility or suggest improvements for specific roles?";
                } else {
                    return "I notice you haven't uploaded a resume yet. This is crucial for job matching! Please upload your resume in the AI Resume Assistant section, and I'll help you optimize it for better job matches.";
                }
            }
            
            if (lowerMessage.includes('interview')) {
                return `I can help you prepare for interviews! ${profile?.current_title ? `As a ${profile.current_title},` : ''} here are some tips: Practice STAR method responses, research the company thoroughly, prepare questions about the role and team. Would you like specific interview questions for your field?`;
            }
            
            if (lowerMessage.includes('network')) {
                return "Networking is key to job success! Check out the Network Recommendations section where I suggest relevant professionals from your target companies. Would you like tips on how to approach them or craft connection messages?";
            }
            
            if (lowerMessage.includes('salary')) {
                if (profile?.salary_range_from) {
                    return `Based on your profile with a target range of $${profile.salary_range_from}${profile.salary_range_to ? `-$${profile.salary_range_to}` : '+'}, I can help you negotiate effectively. Research market rates, highlight your unique value, and consider the total compensation package. Need help with salary negotiation strategies?`;
                } else {
                    return "Salary negotiation is important! First, complete your salary expectations in your profile. Then I can provide personalized advice based on your experience level and location. What's your current situation?";
                }
            }
            
            // Default helpful response
            return `Hello! I'm here to help with your career journey. I can assist with job searching, resume optimization, interview preparation, networking strategies, and more. ${profile?.first_name ? `${profile.first_name}, ` : ''}what would you like to work on today?`;
        }

