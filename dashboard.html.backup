        async function loadJobApplications() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: applications, error } = await window.supabase
                    .from('job_applications')
                    .select(`
                        *,
                        companies:company_id (
                            name,
                            website
                        )
                    `)
                    .eq('user_id', session.user.id)
                    .order('application_date', { ascending: false })
                    .limit(10);

                if (error && error.code !== 'PGRST116') {
                    throw error;
                }

                const applicationsList = document.getElementById('applicationsList');
                if (!applicationsList) return;

                if (applications && applications.length > 0) {
                    applicationsList.innerHTML = applications.map(app => {
                        const company = app.companies;
                        const statusClass = getStatusClass(app.status);
                        const applicationDate = new Date(app.application_date).toLocaleDateString();
                        
                        return `
                            <div class="job-card application-card">
                                <div class="job-header">
                                    <div>
                                        <div class="job-title">${app.job_title}</div>
                                        <div class="job-company">${company?.name || 'Unknown Company'}</div>
                                    </div>
                                    <div class="job-status ${statusClass}">${app.status.charAt(0).toUpperCase() + app.status.slice(1)}</div>
                                </div>
                                <div class="job-meta">
                                    <span><i class="fas fa-calendar"></i> Applied: ${applicationDate}</span>
                                    ${app.job_url ? `<a href="${app.job_url}" target="_blank"><i class="fas fa-external-link-alt"></i> View Job</a>` : ''}
                                </div>
                                ${app.notes ? `<div class="application-notes"><strong>Notes:</strong> ${app.notes}</div>` : ''}
                                <div class="job-actions">
                                    <button class="Button Button-secondary" onclick="updateApplicationStatus('${app.id}')">
                                        <i class="fas fa-edit"></i> Update Status
                                    </button>
                                    ${app.job_url ? `<a href="${app.job_url}" target="_blank" class="Button Button-primary">View Job</a>` : ''}
                                </div>
                            </div>
                        `;
                    }).join('');
                    
                    // Update stats
                    updateApplicationStats(applications);
                } else {
                    applicationsList.innerHTML = `
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            No applications tracked yet. Add your first application to start tracking your job search progress.
                        </div>
                    `;
                }
            } catch (error) {
                console.error('[Dashboard] Error loading job applications:', error);
            }
        }

        function getStatusClass(status) {
            switch(status) {
                case 'applied': return 'status-applied';
                case 'interviewed': return 'status-interviewed';
                case 'rejected': return 'status-rejected';
                case 'offer': return 'status-offer';
                case 'withdrawn': return 'status-rejected';
                default: return 'status-applied';
            }
        }

        function updateApplicationStats(applications) {
            const monthlyApps = applications.filter(app => {
                const appDate = new Date(app.application_date);
                const monthAgo = new Date();
                monthAgo.setMonth(monthAgo.getMonth() - 1);
                return appDate >= monthAgo;
            }).length;

            const responseCount = applications.filter(app => 
                ['interviewed', 'rejected', 'offer'].includes(app.status)
            ).length;

            const interviewCount = applications.filter(app => 
                ['interviewed', 'offer'].includes(app.status)
            ).length;

            const responseRate = applications.length > 0 ? Math.round((responseCount / applications.length) * 100) : 0;
            const interviewRate = applications.length > 0 ? Math.round((interviewCount / applications.length) * 100) : 0;

            // Update dashboard stats
            const monthlyElement = document.querySelector('[data-stat="monthly-applications"]');
            const responseElement = document.querySelector('[data-stat="response-rate"]');
            const interviewElement = document.querySelector('[data-stat="interview-rate"]');

            if (monthlyElement) monthlyElement.textContent = monthlyApps;
            if (responseElement) responseElement.textContent = responseRate + '%';
            if (interviewElement) interviewElement.textContent = interviewRate + '%';
        }

        // Make loadJobApplications globally available
        window.loadJobApplications = loadJobApplications;

        async function loadExistingResume() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                // Get the most recent resume for this user
                const { data: resume, error } = await window.supabase
                    .from('resumes')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (error && error.code !== 'PGRST116') {
                    console.error('[Dashboard] Error loading resume:', error);
                    return;
                }

                if (resume) {
                    const fileSize = (resume.file_size / (1024 * 1024)).toFixed(1) + ' MB';
                    const uploadTime = new Date(resume.uploaded_at || resume.created_at);
                    updateResumeUI(resume.file_name, fileSize, uploadTime);
                    console.log('[Dashboard] Existing resume loaded:', resume.file_name);
                } else {
                    console.log('[Dashboard] No existing resume found');
                }
            } catch (error) {
                console.error('[Dashboard] Error loading existing resume:', error);
            }
        }

        async function loadUserProfile(user) {
            try {
                console.log('[Dashboard] Loading profile for user:', user.id);
                
                const { data: profile, error } = await window.supabase
                    .from('profiles')
                    .select('*')
                    .eq('user_id', user.id)
                    .maybeSingle();

                if (error && error.code !== 'PGRST116') {
                    throw error;
                }

                if (profile) {
                    console.log('[Dashboard] Profile found, populating form fields');
                    // Populate profile form fields
                    populateProfileForm(profile);
                } else {
                    console.log('[Dashboard] No profile found, creating default profile');
                    // Create default profile
                    await createDefaultProfile(user);
                }
            } catch (error) {
                console.error('[Dashboard] Error loading profile:', error);
            }
        }

        function populateProfileForm(profile) {
            // Personal Information
            const fields = {
                'firstName': profile.first_name,
                'lastName': profile.last_name,
                'email': profile.email,
                'phone': profile.phone,
                'linkedinUrl': profile.linkedin_url,
                'country': profile.country || 'US',
                'city': profile.city,
                'state': profile.state,
                'visaStatus': profile.visa_status,
                'visaExpiry': profile.visa_expiry,
                'currentTitle': profile.current_title,
                'experience': profile.experience_level,
                'salaryFrom': profile.salary_range_from,
                'salaryTo': profile.salary_range_to,
                'skills': profile.skills
            };

            Object.entries(fields).forEach(([fieldId, value]) => {
                const field = document.getElementById(fieldId);
                if (field && value) {
                    field.value = value;
                }
            });

            // Handle checkboxes for job types, work modes, contract types
            // Support both array format and JSON string format for backward compatibility
            if (profile.job_types) {
                let jobTypes = [];
                try {
                    jobTypes = Array.isArray(profile.job_types) ? profile.job_types : JSON.parse(profile.job_types || '[]');
                } catch (e) {
                    console.warn('Failed to parse job_types:', profile.job_types);
                    jobTypes = [];
                }
                jobTypes.forEach(type => {
                    const checkbox = document.querySelector(`input[name="jobTypes"][value="${type}"]`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            if (profile.work_modes) {
                let workModes = [];
                try {
                    workModes = Array.isArray(profile.work_modes) ? profile.work_modes : JSON.parse(profile.work_modes || '[]');
                } catch (e) {
                    console.warn('Failed to parse work_modes:', profile.work_modes);
                    workModes = [];
                }
                workModes.forEach(mode => {
                    const checkbox = document.querySelector(`input[name="workModes"][value="${mode}"]`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            if (profile.contract_types) {
                let contractTypes = [];
                try {
                    contractTypes = Array.isArray(profile.contract_types) ? profile.contract_types : JSON.parse(profile.contract_types || '[]');
                } catch (e) {
                    console.warn('Failed to parse contract_types:', profile.contract_types);
                    contractTypes = [];
                }
                contractTypes.forEach(type => {
                    const checkbox = document.querySelector(`input[name="contractTypes"][value="${type}"]`);
                    if (checkbox) checkbox.checked = true;
                });
            }

            // Handle employment status
            const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
            if (employmentRadios.length > 0) {
                const statusValue = profile.is_employed ? 'employed' : 'unemployed';
                employmentRadios.forEach(radio => {
                    radio.checked = radio.value === statusValue;
                });
                
                // Set unemployed since date if applicable
                if (!profile.is_employed && profile.unemployed_since) {
                    const unemployedSinceField = document.getElementById('unemployedSinceDate');
                    if (unemployedSinceField) {
                        unemployedSinceField.value = profile.unemployed_since;
                    }
                }
            }
        }

        async function createDefaultProfile(user) {
            try {
                const defaultProfile = {
                    user_id: user.id,
                    email: user.email,
                    first_name: user.user_metadata?.full_name?.split(' ')[0] || '',
                    last_name: user.user_metadata?.full_name?.split(' ').slice(1).join(' ') || ''
                    // Don't include timestamps - let the database handle them with defaults
                };

                const { data, error } = await window.supabase
                    .from('profiles')
                    .insert([defaultProfile])
                    .select()
                    .single();

                if (error) throw error;
                console.log('[Dashboard] Default profile created:', data);
                return data;
            } catch (error) {
                console.error('[Dashboard] Error creating default profile:', error);
                return null;
            }
        }

        async function loadDashboardStats(userId) {
            try {
                // For now, just set default stats since these tables might not exist yet
                const stats = {
                    'active-applications': 0,
                    'interviews': 0,
                    'offers': 0,
                    'ghost-jobs': 0
                };

                // Update dashboard stats
                Object.entries(stats).forEach(([statKey, value]) => {
                    const statElement = document.querySelector(`[data-stat="${statKey}"]`);
                    if (statElement) {
                        statElement.textContent = value;
                    }
                });

                console.log('[Dashboard] Dashboard stats loaded with default values');
            } catch (error) {
                console.error('[Dashboard] Error loading dashboard stats:', error);
            }
        }

        async function loadUserPreferences(userId) {
            try {
                // For now, skip loading preferences since job_alerts table might not exist
                console.log('[Dashboard] User preferences loading skipped (table may not exist yet)');
            } catch (error) {
                console.error('[Dashboard] Error loading user preferences:', error);
            }
        }

        async function loadFavoriteCompanies() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return;

                const { data: userCompanies, error } = await window.supabase
                    .from('user_companies')
                    .select(`
                        id,
                        preferred_location,
                        reason,
                        companies:company_id (
                            name,
                            website,
                            linkedin_url,
                            headquarters,
                            description
                        )
                    `)
                    .eq('user_id', session.user.id)
                    .order('created_at', { ascending: false })
                    .limit(5);

                const companiesList = document.getElementById('favoriteCompaniesList');
                if (!companiesList) return;

                if (!error && userCompanies && userCompanies.length > 0) {
                    companiesList.innerHTML = userCompanies.map(uc => {
                        const company = uc.companies;
                        return `
                            <div class="company-card">
                                <div class="company-info">
                                    <div class="company-name">${company.name}</div>
                                    <div class="company-industry">Looking for: ${uc.preferred_location || 'Any location'}</div>
                                    <div class="company-reason">Reason: ${uc.reason || 'No reason provided'}</div>
                                </div>
                                <div class="company-actions">
                                    <a href="${company.website}" target="_blank" class="Button Button-secondary">
                                        <i class="fas fa-external-link-alt"></i> Website
                                    </a>
                                    <a href="${company.linkedin_url}" target="_blank" class="Button Button-primary">
                                        <i class="fab fa-linkedin"></i> LinkedIn
                                    </a>
                                    <button class="Button Button-danger" onclick="removeFavoriteCompany('${uc.id}')">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join('');
                } else {
                    companiesList.innerHTML = `
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            No favorite companies added yet. Click "Add Company" to start tracking your target companies.
                        </div>
                    `;
                }
            } catch (error) {
                console.error('[Dashboard] Error loading favorite companies:', error);
            }
        }

        // Function to remove favorite company
        async function removeFavoriteCompany(userCompanyId) {
            try {
                if (!confirm('Are you sure you want to remove this company from your favorites?')) {
                    return;
                }

                const { error } = await window.supabase
                    .from('user_companies')
                    .delete()
                    .eq('id', userCompanyId);

                if (error) throw error;

                alert('Company removed from favorites successfully!');
                loadFavoriteCompanies(); // Refresh the list
            } catch (error) {
                console.error('[Dashboard] Error removing favorite company:', error);
                alert('Error removing company. Please try again.');
            }
        }

        // Make remove function globally available
        window.removeFavoriteCompany = removeFavoriteCompany;

        // Function to get user's resume data for GPT integration
        async function getUserResumeForGPT() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return null;

                const { data: resume } = await window.supabase
                    .from('resumes')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .order('uploaded_at', { ascending: false })
                    .limit(1)
                    .maybeSingle();

                if (resume) {
                    return {
                        fileName: resume.file_name,
                        fileType: resume.file_type,
                        fileUrl: resume.file_url,
                        uploadDate: resume.uploaded_at || resume.created_at
                    };
                }
                return null;
            } catch (error) {
                console.error('[Dashboard] Error getting resume for GPT:', error);
                return null;
            }
        }

        // Function to get user's complete profile for GPT integration
        async function getUserProfileForGPT() {
            try {
                const { data: { session } } = await window.supabase.auth.getSession();
                if (!session) return null;

                const { data: profile } = await window.supabase
                    .from('profiles')
                    .select('*')
                    .eq('user_id', session.user.id)
                    .maybeSingle();

                const resumeData = await getUserResumeForGPT();

                return {
                    profile: profile,
                    resume: resumeData,
                    userId: session.user.id,
                    email: session.user.email
                };
            } catch (error) {
                console.error('[Dashboard] Error getting profile for GPT:', error);
                return null;
            }
        }

        // Make these functions globally available for GPT integration
        window.getUserResumeForGPT = getUserResumeForGPT;
        window.getUserProfileForGPT = getUserProfileForGPT;
        
        // Make job functions globally available
        window.saveJobForLater = saveJobForLater;
        window.analyzeJob = analyzeJob;
        window.getScoreClass = getScoreClass;

        function displayApprenticeshipResults(result) {
            const resultsContainer = document.querySelector('.search-results');
            if (!resultsContainer) return;
            
            // Function implementation would continue here...
            console.log('Apprenticeship results:', result);
        }
