                <div class="chatbot-container" style="height: calc(100vh - 200px); display: flex; flex-direction: column;">
                    <div class="chat-messages" id="chatMessages" style="flex: 1; overflow-y: auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 10px; margin-bottom: 20px;">
