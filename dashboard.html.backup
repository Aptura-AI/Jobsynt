              <!-- Profile Section -->
<section id="profile" class="content-section">
    <div class="section-header">
    <h2>Your Profile</h2>
    <p>Complete your profile for the best job matching experience. This information will be used to find your perfect job matches.</p>
    </div>
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        <strong>Important:</strong> Please complete your profile and upload your resume in the AI Resume Assistant section for the best job matching experience.
    </div>
  <div class="profile-content">
    <form id="profileForm">
      <!-- Personal Information -->
      <div class="form-section">
        <h3>Personal Information</h3>
            <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First Name <span class="required-asterisk">*</span></label>
                        <input type="text" id="firstName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last Name <span class="required-asterisk">*</span></label>
                        <input type="text" id="lastName" class="form-control" required>
                    </div>
                </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" class="form-control" required>
            </div>
                    <div class="form-group">
          <label for="phone">Phone Number <span class="required-asterisk">*</span></label>
          <input type="tel" id="phone" class="form-control" required>
                    </div>
                    <div class="form-group">
          <label for="linkedinUrl">LinkedIn Profile URL</label>
          <input type="url" id="linkedinUrl" class="form-control" placeholder="https://linkedin.com/in/yourprofile">
            </div>
            
             <div class="form-row">
                    <div class="form-group">
            <label for="country">Country</label>
            <select id="country" class="form-control" required>
              <option value="US" selected>United States</option>
              <option value="CA">Canada</option>
              <option value="GB">United Kingdom</option>
              <option value="AU">Australia</option>
              <option value="IN">India</option>
              <!-- Add more countries as needed -->
            </select>
          </div>
        <div class="form-group" id="stateGroup">
          <label for="state">State</label>
          <select id="state" class="form-control">
                            <option value="">Select State</option>
            <!-- US States will be populated by JavaScript -->
                        </select>
                </div>
          <div class="form-group">
            <label for="city">City</label>
                        <input type="text" id="city" class="form-control" required>
                    </div>
                </div>
            </div>
            
      <!-- Visa Information -->
      <div class="form-section">
        <h3>Visa Status</h3>
                    <div class="form-group">
          <label for="visaStatus">Work Authorization</label>
                        <select id="visaStatus" class="form-control" required>
            <option value="">Select Visa Status</option>
            <option value="Citizen">US Citizen</option>
            <option value="Green Card">Green Card</option>
            <option value="GC EAD">GC EAD</option>
            <option value="H1B">H1B</option>
            <option value="H4 EAD">H4 EAD</option>
            <option value="L2EAD">L2EAD</option>
            <option value="F1 OPT">F1 OPT</option>
            <option value="F1 STEM OPT">F1 STEM OPT</option>
            <option value="Others">Other (Please Specify)</option>
                        </select>
                    </div>
        <div class="form-group" id="otherVisaGroup" style="display: none;">
          <label for="otherVisa">Specify Visa Type</label>
          <input type="text" id="otherVisa" class="form-control">
            </div>
        <div class="form-group" id="visaExpiryGroup" style="display: none;">
          <label for="visaExpiry">Visa Expiry Date <span class="required-asterisk">*</span></label>
          <input type="date" id="visaExpiry" class="form-control">
          <small class="form-text text-muted">This information may be required by employers for work authorization verification.</small>
            </div>
        </div>
        
      <!-- Employment Status -->
      <div class="form-section">
        <h3>Employment Status</h3>
                    <div class="form-group">
                        <label>Are you currently employed?</label>
                        <div class="form-row">
                            <label class="radio-inline">
                                <input type="radio" name="employmentStatus" value="employed" checked> Yes, I'm employed
                            </label>
                            <label class="radio-inline">
                                <input type="radio" name="employmentStatus" value="unemployed"> No, I'm unemployed
                            </label>
                        </div>
                    </div>
        <div class="form-group" id="unemployedSinceGroup" style="display: none;">
          <label for="unemployedSinceDate">Unemployed Since Date</label>
          <input type="date" id="unemployedSinceDate" class="form-control">
                </div>
            </div>
            
      <!-- Professional Information -->
      <div class="form-section">
        <h3>Professional Information</h3>
                    <div class="form-group">
          <label for="currentTitle">Current Title</label>
          <input type="text" id="currentTitle" class="form-control" required>
                    </div>
                    <div class="form-group">
          <label for="experience">Experience Level</label>
          <select id="experience" class="form-control" required>
            <option value="">Select Experience Level</option>
            <option value="entry">Entry Level (0-2 years)</option>
            <option value="mid">Mid Level (3-5 years)</option>
            <option value="senior">Senior Level (6-10 years)</option>
            <option value="lead">Lead/Manager (10+ years)</option>
                        </select>
                    </div>
                    <div class="form-group">
          <label>Job Types (Select all that apply)</label>
          <div class="checkbox-group">
            <label class="checkbox-inline">
              <input type="checkbox" name="jobTypes" value="full-time"> Full-time
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="jobTypes" value="part-time"> Part-time
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="jobTypes" value="contract"> Contract
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="jobTypes" value="internship"> Internship
            </label>
                    </div>
                </div>
                    <div class="form-group">
          <label>Work Mode (Select all that apply)</label>
          <div class="checkbox-group">
            <label class="checkbox-inline">
              <input type="checkbox" name="workModes" value="remote"> Remote
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="workModes" value="hybrid"> Hybrid
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="workModes" value="onsite"> On-site
            </label>
                    </div>
                </div>
            <div class="form-group">
          <label>Contract Types (Select all that apply)</label>
                <div class="checkbox-group">
            <label class="checkbox-inline">
              <input type="checkbox" name="contractTypes" value="w2-fulltime"> W2 Full-time
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="contractTypes" value="w2-contract"> W2 Contract
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="contractTypes" value="c2c"> C2C Contract
            </label>
            <label class="checkbox-inline">
              <input type="checkbox" name="contractTypes" value="1099"> 1099 Contract
            </label>
                    </div>
                    </div>
            <div class="form-group">
          <label>Expected Salary Range (Annual)</label>
          <div class="form-row">
            <div class="form-col">
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" id="salaryFrom" class="form-control" placeholder="From" min="0" step="1000">
                    </div>
                    </div>
            <div class="form-col">
              <div class="input-group">
                <span class="input-group-text">$</span>
                <input type="number" id="salaryTo" class="form-control" placeholder="To" min="0" step="1000">
                    </div>
                    </div>
                </div>
            </div>
        <div class="form-group">
          <label for="skills">Skills (comma-separated)</label>
          <input type="text" id="skills" class="form-control" required>
        </div>
            </div>
            
      <button type="submit" class="Button Button-primary">Save Profile</button>
    </form>
  </div>
</section>

<script>
// Initialize state dropdown for US
const usStates = [
  'Alabama', 'Alaska', 'Arizona', 'Arkansas', 'California', 'Colorado', 'Connecticut', 'Delaware',
  'Florida', 'Georgia', 'Hawaii', 'Idaho', 'Illinois', 'Indiana', 'Iowa', 'Kansas', 'Kentucky',
  'Louisiana', 'Maine', 'Maryland', 'Massachusetts', 'Michigan', 'Minnesota', 'Mississippi',
  'Missouri', 'Montana', 'Nebraska', 'Nevada', 'New Hampshire', 'New Jersey', 'New Mexico',
  'New York', 'North Carolina', 'North Dakota', 'Ohio', 'Oklahoma', 'Oregon', 'Pennsylvania',
  'Rhode Island', 'South Carolina', 'South Dakota', 'Tennessee', 'Texas', 'Utah', 'Vermont',
  'Virginia', 'Washington', 'West Virginia', 'Wisconsin', 'Wyoming'
];

const stateSelect = document.getElementById('state');
usStates.forEach(state => {
  const option = document.createElement('option');
  option.value = state;
  option.textContent = state;
  stateSelect.appendChild(option);
});

// Handle country change
document.getElementById('country').addEventListener('change', function() {
  const stateGroup = document.getElementById('stateGroup');
  if (this.value === 'US') {
    stateGroup.style.display = 'block';
    stateSelect.setAttribute('required', 'required');
  } else {
    stateGroup.style.display = 'none';
    stateSelect.removeAttribute('required');
    stateSelect.value = '';
  }
});

        // Handle visa type change
        document.getElementById('visaStatus').addEventListener('change', function() {
            const otherVisaGroup = document.getElementById('otherVisaGroup');
            const visaExpiryGroup = document.getElementById('visaExpiryGroup');
            
            if (this.value === 'Others') {
                otherVisaGroup.style.display = 'block';
                document.getElementById('otherVisa').setAttribute('required', 'required');
            } else {
                otherVisaGroup.style.display = 'none';
                document.getElementById('otherVisa').removeAttribute('required');
            }
            
            // Show expiry date for all visa types except Citizen and Green Card
            if (this.value && this.value !== 'Citizen' && this.value !== 'Green Card') {
                visaExpiryGroup.style.display = 'block';
                document.getElementById('visaExpiry').setAttribute('required', 'required');
            } else {
                visaExpiryGroup.style.display = 'none';
                document.getElementById('visaExpiry').removeAttribute('required');
                document.getElementById('visaExpiry').value = ''; // Clear the date
            }
        });

// Handle employment status change in Profile section
document.querySelectorAll('input[name="employmentStatus"]').forEach(radio => {
    radio.addEventListener('change', function() {
        const unemployedGroup = document.getElementById('unemployedSinceGroup');
        if (this.value === 'unemployed') {
            unemployedGroup.style.display = 'block';
            document.getElementById('unemployedSinceDate').setAttribute('required', 'required');
        } else {
            unemployedGroup.style.display = 'none';
            document.getElementById('unemployedSinceDate').removeAttribute('required');
            document.getElementById('unemployedSinceDate').value = '';
        }
    });
});

// Initialize form state
function initFormState() {
  const countryField = document.getElementById('country');
  const visaField = document.getElementById('visaStatus');
  
  if (countryField) {
    countryField.dispatchEvent(new Event('change'));
  }
  if (visaField) {
    visaField.dispatchEvent(new Event('change'));
  }
  
  // Handle employment status for radio buttons
  const employmentRadios = document.querySelectorAll('input[name="employmentStatus"]');
  if (employmentRadios.length > 0) {
    employmentRadios[0].dispatchEvent(new Event('change'));
  }
}

// Initialize form on load
window.addEventListener('DOMContentLoaded', initFormState);
</script>

<style>
.required-asterisk {
  color: #ff0000;
  margin-left: 4px;
}

.form-section {
  margin-bottom: 25px;
  padding-bottom: 15px;
  border-bottom: 1px solid #eee;
}

.form-group {
  margin-bottom: 15px;
}

.form-check {
  margin-bottom: 10px;
}

#stateGroup, #otherVisaGroup, #unemployedSinceGroup {
  transition: all 0.3s ease;
}

.radio-inline {
  display: inline-flex;
  align-items: center;
  margin-right: 20px;
  cursor: pointer;
}

.radio-inline input[type="radio"] {
  margin-right: 8px;
}
</style>

              <!-- AI Resume assistance Sections -->
            <section id="ai-resume" class="content-section">
  <div class="section-header">
                    <h2>AI Resume Assistant</h2>
                    <p>Upload your resume for personalized recommendations and create targeted cover letters</p>
  </div>
  <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Required:</strong> Please upload your first resume to enable job matching. This is mandatory for the best job search experience.
    </div>
                <div class="resume-section">
                    <h3>Resume Upload</h3>
                    <div class="upload-area" id="resumeUpload">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <p>Drag & drop your resume here or click to browse</p>
                        <p class="upload-info">Supported formats: PDF, DOC, DOCX</p>
                        <input type="file" id="resumeFile" accept=".pdf,.doc,.docx" style="display: none;">
    </div>
                    <div id="currentResume" class="hidden">
                        <div class="resume-info">
                            <i class="fas fa-file-alt"></i>
                            <div class="resume-details">
                                <p class="resume-name">Current Resume: <span id="resumeName"></span></p>
                                <p class="resume-upload-time">Uploaded: <span id="uploadTime"></span></p>
      </div>
        </div>
                        <div class="resume-actions">
                            <button type="button" class="Button Button-secondary" id="viewResume">
                                <i class="fas fa-eye"></i> View
        </button>
                            <button type="button" class="Button Button-primary" id="replaceResume">
                                <i class="fas fa-sync-alt"></i> Replace
        </button>
                            <button type="button" class="Button Button-danger" id="deleteResume">
                                <i class="fas fa-trash"></i> Delete
          </button>
        </div>
      </div>
        </div>
                <div class="resume-analysis">
                    <h3>General Resume Analysis</h3>
                    <div class="analysis-results">
                        <!-- Resume analysis results will be shown here -->
      </div>
    </div>
                <div class="job-specific-analysis">
                    <h3>Job-Specific Analysis</h3>
                    <form id="jobAnalysisForm">
                        <div class="form-group">
                            <label for="jobUrlAnalysis">Job URL</label>
                            <input type="url" id="jobUrlAnalysis" class="form-control">
  </div>
                        <div class="form-group">
                            <label for="jobDescriptionPreview">Job Description</label>
                            <textarea id="jobDescriptionPreview" class="form-control" rows="4"></textarea>
                                </div>
                        <button type="submit" class="Button Button-primary">Analyze</button>
                    </form>
  </div>
                <div class="cover-letter-section">
                    <h3>Cover Letter Generator</h3>
                    <button class="Button Button-success" id="generateCoverLetter">Generate Cover Letter</button>
                    <div class="cover-letter-preview hidden">
                        <!-- Cover letter preview will be shown here -->
      </div>
